            <a href="#" onclick="openModal('note-modal')" class="nav-item"><i class="fas fa-sd-card"></i> <span>HAFIZA</span></a>
            <div style="height: 1px; background: rgba(255,255,255,0.1); margin: 15px 0;"></div>
            <a href="#" class="nav-item"><i class="fas fa-wrench"></i> <span>BAKIM/ONARIM</span></a>
            <a href="#" class="nav-item"><i class="fas fa-map-location-dot"></i> <span>FİLO HARİTASI</span></a>
