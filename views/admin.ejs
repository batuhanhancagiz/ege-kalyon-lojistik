<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@300;500;600;700&display=swap" rel="stylesheet">
    <title>Ege Kalyon | Terminal V5.0 ULTRA</title>
    <style>
        :root { 
            --neon-blue: #00f3ff;
            --neon-purple: #bc13fe;
            --neon-pink: #ff0055;
            --neon-yellow: #fcee0a;
            --bg-dark: #020205;
            --glass-bg: rgba(10, 10, 20, 0.65);
            --glass-border: rgba(0, 243, 255, 0.3);
            --text-main: #e0e0e0;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Rajdhani', sans-serif;
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
            font-size: 16px;
        }

        /* --- CANLI ARKA PLAN & EFEKTLER --- */
        
        /* Derinlik Izgarası */
        .cyber-grid-floor {
            position: fixed; bottom: -30%; left: -50%; width: 200%; height: 100%;
            background-image: 
                linear-gradient(var(--neon-purple) 1px, transparent 1px),
                linear-gradient(90deg, var(--neon-blue) 1px, transparent 1px);
            background-size: 60px 60px;
            transform: perspective(500px) rotateX(60deg);
            opacity: 0.15;
            animation: moveGrid 15s linear infinite;
            z-index: -2;
            box-shadow: 0 -50px 100px var(--bg-dark) inset; /* Ufuk çizgisi yumuşatma */
        }

        @keyframes moveGrid { 0% { background-position: 0 0; } 100% { background-position: 0 60px; } }

        /* CRT Tarama Çizgileri (Scanlines) */
        .scanlines {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.1));
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.3;
        }

        /* Arka Plan Işık Huzmeleri */
        body::before {
            content: ''; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 0%, rgba(0, 243, 255, 0.1), transparent 60%);
            z-index: -1;
        }

        /* --- SCROLLBAR --- */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #000; }
        ::-webkit-scrollbar-thumb { background: var(--neon-blue); border-radius: 3px; box-shadow: 0 0 10px var(--neon-blue); }

        /* --- SIDEBAR --- */
        .sidebar { 
            width: 280px; height: 100vh; position: fixed; left: 0; top: 0; 
            background: rgba(2, 2, 5, 0.8);
            backdrop-filter: blur(15px);
            border-right: 1px solid var(--glass-border); 
            padding: 40px 20px; z-index: 100; 
            box-shadow: 10px 0 30px rgba(0,0,0,0.5);
        }
        
        .sidebar-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem; font-weight: 900;
            color: #fff;
            text-shadow: 0 0 10px var(--neon-blue), 0 0 20px var(--neon-blue);
            margin-bottom: 50px;
            text-align: center;
            letter-spacing: 2px;
        }
        .sidebar-title span { display: block; font-size: 0.6em; color: var(--neon-purple); letter-spacing: 4px; margin-top: 5px; }

        .nav-item {
            display: flex; align-items: center; gap: 15px; 
            color: #888; text-decoration: none; padding: 15px 20px; 
            margin-bottom: 12px; 
            font-family: 'Orbitron', sans-serif; font-size: 0.9rem; letter-spacing: 1px;
            border-left: 3px solid transparent;
            transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            background: linear-gradient(90deg, transparent, transparent);
        }

        .nav-item:hover, .nav-item.active {
            color: #fff;
            border-left: 3px solid var(--neon-blue);
            background: linear-gradient(90deg, rgba(0, 243, 255, 0.1), transparent);
            padding-left: 25px;
            text-shadow: 0 0 8px var(--neon-blue);
        }
        .nav-item i { width: 25px; text-align: center; }

        /* --- MAIN CONTENT --- */
        .admin-main { flex: 1; margin-left: 280px; min-height: 100vh; display: flex; flex-direction: column; width: calc(100% - 280px); position: relative; z-index: 1; }
        .content-wrapper { padding: 40px; flex: 1; }

        /* --- HEADER --- */
        .glitch-wrapper { position: relative; display: inline-block; }
        .glitch {
            font-family: 'Orbitron', sans-serif; font-size: 2.5rem; font-weight: 900; color: #fff;
            text-transform: uppercase; letter-spacing: 2px;
            text-shadow: 2px 2px var(--neon-pink), -2px -2px var(--neon-blue);
            animation: glitchText 3s infinite alternate;
        }
        @keyframes glitchText {
            0% { text-shadow: 2px 2px var(--neon-pink), -2px -2px var(--neon-blue); transform: skew(0deg); }
            20% { transform: skew(-2deg); }
            40% { transform: skew(2deg); }
            60% { text-shadow: -2px 2px var(--neon-pink), 2px -2px var(--neon-blue); transform: skew(0deg); }
            100% { transform: skew(0deg); }
        }
        
        .system-status { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
        .pulse-dot { width: 12px; height: 12px; background: var(--neon-blue); border-radius: 50%; box-shadow: 0 0 10px var(--neon-blue); animation: pulse 2s infinite; }
        @keyframes pulse { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } 100% { opacity: 1; transform: scale(1); } }

        #digital-clock { 
            font-family: 'Orbitron', sans-serif; font-size: 3rem; font-weight: 800; color: #fff;
            text-shadow: 0 0 15px rgba(255,255,255,0.4); line-height: 1;
        }
        #digital-date { color: var(--neon-purple); letter-spacing: 3px; font-weight: 700; text-align: right; font-family: 'Rajdhani'; font-size: 1.1rem; text-transform: uppercase; }

        /* --- CARDS (KARTLAR) --- */
        .grid-cockpit-v2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 25px; margin-top: 50px; }
        
        .cyber-card { 
            background: var(--glass-bg);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 30px; 
            border-radius: 15px; /* Yumuşak köşeler ama teknolojik */
            position: relative; overflow: hidden;
            transition: 0.4s ease;
            cursor: pointer;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

        /* Kart Parlama Efekti */
        .cyber-card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);
            opacity: 0; transition: 0.4s;
        }

        /* Kart Kenar Çizgileri */
        .cyber-card::after {
            content: ''; position: absolute; bottom: 0; right: 0; width: 30px; height: 30px;
            border-bottom: 2px solid var(--neon-blue); border-right: 2px solid var(--neon-blue);
            border-radius: 0 0 15px 0;
            transition: 0.4s;
        }

        .cyber-card:hover { 
            transform: translateY(-10px) scale(1.02);
            border-color: var(--neon-blue);
            box-shadow: 0 0 30px rgba(0, 243, 255, 0.2);
        }
        .cyber-card:hover::before { opacity: 1; }
        .cyber-card:hover::after { width: 100%; height: 100%; border-radius: 15px; box-shadow: inset -5px -5px 20px rgba(0, 243, 255, 0.1); }
        
        .cyber-card i { 
            font-size: 2.8rem; margin-bottom: 20px; display: block; 
            filter: drop-shadow(0 0 5px rgba(255,255,255,0.3));
            transition: 0.4s;
        }
        .cyber-card:hover i { transform: scale(1.1) rotate(5deg); filter: drop-shadow(0 0 15px var(--neon-blue)); color: #fff !important; }

        .card-info h3 { font-family: 'Orbitron'; font-size: 1.3rem; margin-bottom: 5px; color: #fff; }
        .card-info p { color: #aaa; font-size: 0.9rem; letter-spacing: 1px; font-weight: 600; text-transform: uppercase; }

        /* --- MODAL (HUD STYLE) --- */
        .modal { display: none; position: fixed; z-index: 3000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); }
        .modal-content { 
            background: rgba(5, 5, 10, 0.95); margin: 3% auto; padding: 40px; 
            border: 1px solid var(--neon-blue); 
            border-top: 3px solid var(--neon-blue);
            border-bottom: 3px solid var(--neon-purple);
            width: 90%; max-width: 900px; 
            box-shadow: 0 0 50px rgba(0, 243, 255, 0.2); 
            position: relative;
            background-image: 
                linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 30px 30px;
        }

        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; }
        .modal-header h2 { font-family: 'Orbitron'; font-size: 1.8rem; color: #fff; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 0 10px var(--neon-blue); }
        .modal-header span { color: var(--neon-pink); font-size: 2rem; cursor: pointer; transition: 0.3s; }
        .modal-header span:hover { transform: rotate(90deg) scale(1.2); text-shadow: 0 0 15px var(--neon-pink); }

        /* --- INPUTS & BUTTONS --- */
        .cyber-input {
            background: rgba(0,0,0,0.4); 
            border: 1px solid rgba(255,255,255,0.2); 
            color: #fff; 
            padding: 15px 20px; 
            width: 100%; 
            outline: none;
            font-family: 'Rajdhani', monospace; font-size: 1.1rem; font-weight: 600; letter-spacing: 1px;
            transition: 0.3s;
            border-radius: 5px;
        }
        .cyber-input:focus { border-color: var(--neon-blue); box-shadow: 0 0 15px rgba(0, 243, 255, 0.2); background: rgba(0, 243, 255, 0.05); }

        .cyber-btn {
            background: linear-gradient(90deg, transparent, rgba(0, 243, 255, 0.1), transparent);
            border: 1px solid var(--neon-blue);
            color: var(--neon-blue);
            padding: 15px 40px;
            font-family: 'Orbitron'; font-weight: 800; letter-spacing: 2px;
            cursor: pointer; transition: 0.3s; text-transform: uppercase;
            position: relative; overflow: hidden;
            border-radius: 5px;
        }
        .cyber-btn::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
            transition: 0.5s;
        }
        .cyber-btn:hover {
            background: var(--neon-blue); color: #000; box-shadow: 0 0 30px var(--neon-blue);
        }
        .cyber-btn:hover::before { left: 100%; }

        /* --- TABLES --- */
        .driver-table { width:100%; border-collapse: separate; border-spacing: 0 8px; margin-top: 20px; }
        .driver-table th { text-align: left; padding: 15px; color: #888; font-family: 'Orbitron'; letter-spacing: 1px; font-size: 0.8rem; text-transform: uppercase; border-bottom: 2px solid var(--glass-border); }
        .driver-table td { padding: 15px; background: rgba(255,255,255,0.02); color: #ccc; font-weight: 500; border: 1px solid transparent; transition: 0.3s; }
        .driver-table tr:hover td { background: rgba(0, 243, 255, 0.05); border-color: rgba(0, 243, 255, 0.2); color: #fff; box-shadow: inset 0 0 10px rgba(0, 243, 255, 0.1); }
        
        .expired-warning { color: var(--neon-pink) !important; font-weight: 800; text-shadow: 0 0 10px var(--neon-pink); animation: blink 0.8s infinite alternate; }
        @keyframes blink { from { opacity: 1; } to { opacity: 0.4; } }

        /* --- FOOTER --- */
        .admin-footer { padding: 30px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center; color: #555; font-family: 'Orbitron'; font-size: 0.75rem; letter-spacing: 2px; margin-top: auto; }
        
        @media (max-width: 1024px) {
            .sidebar { width: 80px; padding: 20px 10px; }
            .sidebar-title, .sidebar-nav a span { display: none; }
            .admin-main { margin-left: 80px; width: calc(100% - 80px); }
        }
    </style>
</head>
<body>
    <div class="scanlines"></div> <div class="cyber-grid-floor"></div> <aside class="sidebar">
        <div class="sidebar-title">
            EGE KALYON
            <span>OS SYSTEM V1.4</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="nav-item active"><i class="fas fa-microchip"></i> <span>KOKPİT</span></a>
            <a href="#" onclick="openSheets('cizelge')" class="nav-item"><i class="fas fa-file-waveform"></i> <span>VERİ AKIŞI</span></a>
            <a href="#" onclick="openSheets('bekleme')" class="nav-item"><i class="fas fa-hourglass-start"></i> <span>HAKEDİŞ</span></a>
            <a href="#" onclick="openModal('driver-modal')" class="nav-item"><i class="fas fa-users-viewfinder"></i> <span>PERSONEL</span></a>
            <a href="#" onclick="openModal('note-modal')" class="nav-item"><i class="fas fa-sd-card"></i> <span>HAFIZA</span></a>
            <a href="/cikis" class="nav-item" style="color: var(--neon-pink); margin-top: 50px; border-left-color: transparent;"><i class="fas fa-power-off"></i> <span>OTURUMU KAPAT</span></a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="content-wrapper">
            <header class="admin-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 60px;">
                <div data-aos="fade-right">
                    <div class="glitch-wrapper">
                        <h1 class="glitch">TERMİNAL OTORİTESİ</h1>
                    </div>
                    <div class="system-status">
                        <div class="pulse-dot"></div>
                        <p style="color: var(--neon-blue); font-family: 'Orbitron'; letter-spacing: 2px; font-size: 0.8rem;">SİSTEM AKTİF // GÜVENLİ HAT: EGE KALYON</p>
                    </div>
                </div>
                <div style="text-align: right;" data-aos="fade-left">
                    <div id="digital-clock">00:00:00</div>
                    <div id="digital-date">...</div>
                </div>
            </header>

            <section class="grid-cockpit-v2">
                <div class="cyber-card" onclick="openSheets('cizelge')" data-aos="zoom-in" data-aos-delay="100">
                    <i class="fas fa-table-cells" style="color: #4285F4;"></i>
                    <div class="card-info"><h3>DİJİTAL ÇİZELGE</h3><p>OPERASYONEL VERİ</p></div>
                </div>

                <div class="cyber-card" onclick="openSheets('bekleme')" data-aos="zoom-in" data-aos-delay="200">
                    <i class="fas fa-clock" style="color: var(--neon-yellow);"></i>
                    <div class="card-info"><h3>BEKLEME MODÜLÜ</h3><p>CANLI SAYAÇ</p></div>
                </div>

                <a href="https://web.arvento.com/" target="_blank" class="cyber-card" style="text-decoration:none;" data-aos="zoom-in" data-aos-delay="300">
                    <i class="fas fa-satellite-dish" style="color: var(--neon-pink);"></i>
                    <div class="card-info"><h3>ARVENTO SAT</h3><p>GPS UYDU TAKİBİ</p></div>
                </a>

                <a href="https://www.luca.com.tr/" target="_blank" class="cyber-card" style="text-decoration:none;" data-aos="zoom-in" data-aos-delay="400">
                    <i class="fas fa-coins" style="color: var(--neon-purple);"></i>
                    <div class="card-info"><h3>LUCA FİNANS</h3><p>MUHASEBE AĞI</p></div>
                </a>

                <div class="cyber-card" onclick="openModal('driver-modal')" style="border-color: var(--neon-blue);" data-aos="zoom-in" data-aos-delay="500">
                    <i class="fas fa-id-card" style="color: var(--neon-blue);"></i>
                    <div class="card-info"><h3>PERSONEL KAYDI</h3><p>ŞOFÖR & EVRAK</p></div>
                </div>

                <div class="cyber-card" onclick="openModal('sunucu-modal')" data-aos="zoom-in" data-aos-delay="600">
                    <i class="fas fa-server" style="color: #fff;"></i>
                    <div class="card-info"><h3>ANA SUNUCU</h3><p>SİSTEM DURUMU</p></div>
                </div>
            </section>
        </div>

        <footer class="admin-footer">
            <div style="margin-bottom:10px;">EGE KALYON LOJİSTİK SİSTEMLERİ <span style="color:var(--neon-blue)">V1.4</span></div>
            <div style="opacity:0.5;">POWERED BY BATU YAZILIM // 2026</div>
        </footer>
    </main>

    <div id="note-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// HAFIZA NOTLARI</h2><span onclick="closeModal('note-modal')">✕</span></div>
            <div style="display:flex; gap:20px; margin-bottom:30px;">
                <input type="text" id="note-input" placeholder=">> SİSTEME NOT GİRİN..." class="cyber-input">
                <button id="note-save-btn" onclick="addNote()" class="cyber-btn">KAYDET</button>
            </div>
            <ul id="note-list" style="list-style:none;"></ul>
        </div>
    </div>

    <div id="driver-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// ŞOFÖR YÖNETİM PANELİ</h2><span onclick="closeModal('driver-modal')">✕</span></div>
            
            <div style="background:rgba(255,255,255,0.03); padding:30px; border-radius:10px; border:1px solid rgba(255,255,255,0.1); margin-bottom:30px;">
                <h4 style="color:var(--neon-blue); font-family:'Orbitron'; margin-bottom:20px; letter-spacing:1px;">YENİ PERSONEL EKLE</h4>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 25px;">
                    <input type="text" id="d-name" placeholder="AD SOYAD" class="cyber-input">
                    <input type="text" id="d-tc" placeholder="TC KİMLİK" class="cyber-input" maxlength="11">
                    <input type="text" id="d-phone" placeholder="TELEFON" class="cyber-input">
                    <input type="text" id="d-plate" placeholder="ARAÇ PLAKA" class="cyber-input">
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.75rem; color: #888; font-family:'Orbitron'; margin-bottom: 5px;">EHLİYET S.K.T</span>
                        <input type="date" id="d-lic-date" class="cyber-input" style="color-scheme: dark;">
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.75rem; color: #888; font-family:'Orbitron'; margin-bottom: 5px;">SRC S.K.T</span>
                        <input type="date" id="d-src-date" class="cyber-input" style="color-scheme: dark;">
                    </div>
                </div>
                <button onclick="addDriver()" class="cyber-btn" style="width:100%">VERİTABANINA İŞLE</button>
            </div>

            <div style="overflow-x: auto;">
                <table class="driver-table">
                    <thead>
                        <tr>
                            <th>KİMLİK</th>
                            <th>İLETİŞİM / TC</th>
                            <th>ARAÇ ID</th>
                            <th>EHLİYET DURUM</th>
                            <th>SRC DURUM</th>
                            <th style="text-align: right;">KOMUT</th>
                        </tr>
                    </thead>
                    <tbody id="driver-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="sheets-overlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:#000; z-index:4000; display:none; flex-direction:column;">
        <div style="background:#050505; padding:20px; display:flex; justify-content:space-between; border-bottom:2px solid var(--neon-blue);">
            <h2 style="color:var(--neon-blue); font-family:'Orbitron'">HARİCİ VERİ BAĞLANTISI</h2>
            <button onclick="closeSheets()" class="cyber-btn" style="border-color:var(--neon-pink); color:var(--neon-pink);">BAĞLANTIYI KES</button>
        </div>
        <iframe id="sheets-iframe" src="" style="width:100%; height:100%; border:none;"></iframe>
    </div>

    <div id="sunucu-modal" class="modal">
        <div class="modal-content" style="text-align:center; max-width:500px; border-color:var(--neon-blue);">
            <div class="modal-header"><h2>SİSTEM DURUMU</h2><span onclick="closeModal('sunucu-modal')">✕</span></div>
            <div style="font-size:1.5rem; color:var(--neon-blue); margin-bottom:10px; font-family:'Orbitron'">SYSTEM: OPTIMAL</div>
            <div style="font-size:1rem; color:#888; font-family:'Rajdhani'">DATA FLOW: STABLE (12ms)</div>
            <div style="margin-top:40px; font-size:5rem; color:var(--neon-blue); animation: pulse 1.5s infinite;"><i class="fas fa-fingerprint"></i></div>
            <div style="margin-top:20px; color:var(--neon-purple); font-size:0.9rem;">SECURITY LEVEL: MAX</div>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();
        
        // Dijital Saat
        setInterval(() => {
            const now = new Date();
            document.getElementById('digital-clock').innerText = now.toLocaleTimeString('tr-TR');
            document.getElementById('digital-date').innerText = now.toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' }).toUpperCase();
        }, 1000);

        // Modal İşlemleri
        function openModal(id) { document.getElementById(id).style.display = 'block'; if(id==='driver-modal') renderDrivers(); if(id==='note-modal') renderNotes(); }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        // Google Sheets
        function openSheets(type) {
            const overlay = document.getElementById('sheets-overlay');
            const iframe = document.getElementById('sheets-iframe');
            if(type==='cizelge') iframe.src = "https://docs.google.com/spreadsheets/d/1WaSNv0a2Nn-xDiHMX3VsLwYaOwTS5maCtrzRS9zUdlc/edit?rm=minimal";
            else iframe.src = "https://docs.google.com/spreadsheets/d/1sCy68YJYkvFIpQumgP6_tt5mcBFgDm2WLIbvuVHCgIM/edit?rm=minimal";
            overlay.style.display = 'flex';
        }
        function closeSheets() { document.getElementById('sheets-overlay').style.display = 'none'; document.getElementById('sheets-iframe').src = ""; }

        /* NOT SİSTEMİ */
        let editNoteId = null;
        function getNotes() { return JSON.parse(localStorage.getItem('terminal_notes_v3') || '[]'); }
        function saveNotes(notes) { localStorage.setItem('terminal_notes_v3', JSON.stringify(notes)); }
        function addNote() {
            const input = document.getElementById('note-input');
            if(!input.value) return;
            const notes = getNotes();
            const now = new Date();
            const dateStr = now.toLocaleDateString('tr-TR') + " " + now.toLocaleTimeString('tr-TR', {hour: '2-digit', minute:'2-digit'});
            if(editNoteId) {
                const updatedNotes = notes.map(n => n.id === editNoteId ? {...n, text: input.value, date: dateStr} : n);
                saveNotes(updatedNotes); editNoteId = null;
                document.getElementById('note-save-btn').innerText = "KAYDET";
            } else {
                notes.push({ id: Date.now(), text: input.value, date: dateStr, done: false });
                saveNotes(notes);
            }
            input.value = ""; renderNotes();
        }
        function startEdit(id, text) {
            document.getElementById('note-input').value = text;
            editNoteId = id; document.getElementById('note-save-btn').innerText = "GÜNCELLE";
            document.getElementById('note-input').focus();
        }
        function deleteNote(id) { saveNotes(getNotes().filter(n => n.id !== id)); renderNotes(); }
        function toggleNote(id) { saveNotes(getNotes().map(n => n.id === id ? {...n, done: !n.done} : n)); renderNotes(); }
        
        function renderNotes() {
            document.getElementById('note-list').innerHTML = getNotes().map(n => `
                <li style="background:rgba(255,255,255,0.02); padding:15px; margin-bottom:10px; border-left:4px solid ${n.done ? 'var(--neon-blue)' : 'var(--neon-pink)'}; display:flex; justify-content:space-between; align-items:center; transition:0.3s; border-radius:5px;">
                    <span style="${n.done ? 'text-decoration:line-through; opacity:0.5' : ''}; font-family:'Rajdhani'; font-size:1.1rem; font-weight:600; color:#fff;">${n.text} <small style="display:block; color:#666; font-size:0.7em; font-family:'Orbitron'">${n.date}</small></span>
                    <div style="display:flex; gap:15px;">
                        <button onclick="toggleNote(${n.id})" style="background:none; border:none; color:var(--neon-blue); cursor:pointer; font-size:1.2rem;"><i class="fas fa-check"></i></button>
                        <button onclick="startEdit(${n.id}, '${n.text.replace(/'/g, "\\'")}')" style="background:none; border:none; color:#fff; cursor:pointer; font-size:1.2rem;"><i class="fas fa-edit"></i></button>
                        <button onclick="deleteNote(${n.id})" style="background:none; border:none; color:var(--neon-pink); cursor:pointer; font-size:1.2rem;"><i class="fas fa-trash"></i></button>
                    </div>
                </li>`).join('');
        }

        /* ŞOFÖR SİSTEMİ */
        function getDrivers() { return JSON.parse(localStorage.getItem('drivers_v4') || '[]'); }
        function addDriver() {
            const name = document.getElementById('d-name').value;
            const tc = document.getElementById('d-tc').value;
            const phone = document.getElementById('d-phone').value;
            const plate = document.getElementById('d-plate').value;
            const licDate = document.getElementById('d-lic-date').value;
            const srcDate = document.getElementById('d-src-date').value;
            if(!name) { alert("UYARI: İSİM GİRİŞİ ZORUNLUDUR."); return; }
            const drivers = getDrivers();
            drivers.push({ id: Date.now(), name, tc, phone, plate, licDate, srcDate });
            localStorage.setItem('drivers_v4', JSON.stringify(drivers));
            document.getElementById('d-name').value = ""; document.getElementById('d-tc').value = "";
            document.getElementById('d-phone').value = ""; document.getElementById('d-plate').value = "";
            document.getElementById('d-lic-date').value = ""; document.getElementById('d-src-date').value = "";
            renderDrivers();
        }
        function deleteDriver(id) {
            if(confirm('BU KAYIT KALICI OLARAK SİLİNECEK. ONAYLIYOR MUSUNUZ?')) {
                localStorage.setItem('drivers_v4', JSON.stringify(getDrivers().filter(d => d.id !== id)));
                renderDrivers();
            }
        }
        function isExpired(dateString) {
            if (!dateString) return false;
            const today = new Date(); today.setHours(0,0,0,0);
            return new Date(dateString) < today;
        }
        function formatDate(dateString) {
            if (!dateString) return "-";
            return new Date(dateString).toLocaleDateString('tr-TR');
        }
        function renderDrivers() {
            const tbody = document.getElementById('driver-tbody');
            const drivers = getDrivers();
            if (drivers.length === 0) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:30px; color:#555; font-family:\'Orbitron\'">// SİSTEMDE KAYIT BULUNAMADI //</td></tr>'; return; }
            tbody.innerHTML = drivers.map(d => {
                const licExpired = isExpired(d.licDate);
                const srcExpired = isExpired(d.srcDate);
                let licHtml = `<span style="color:var(--neon-blue)">${formatDate(d.licDate)}</span>`;
                if(licExpired) licHtml = `<span class="expired-warning">⚠ SÜRE DOLDU (${formatDate(d.licDate)})</span>`;
                let srcHtml = `<span style="color:var(--neon-blue)">${formatDate(d.srcDate)}</span>`;
                if(srcExpired) srcHtml = `<span class="expired-warning">⚠ SÜRE DOLDU (${formatDate(d.srcDate)})</span>`;
                return `
                <tr>
                    <td><b style="color:#fff; font-size:1.1rem; text-shadow:0 0 5px rgba(255,255,255,0.3)">${d.name}</b></td>
                    <td><div style="font-size:0.9rem; color:#888;">TC: ${d.tc || '-'}</div><div style="font-size:0.9rem; color:var(--neon-blue);">${d.phone || '-'}</div></td>
                    <td><span style="border:1px solid #555; padding:4px 8px; color:#fff; font-family:'Orbitron'; background:rgba(0,0,0,0.5)">${d.plate || '-'}</span></td>
                    <td>${licHtml}</td>
                    <td>${srcHtml}</td>
                    <td style="text-align:right"><button onclick="deleteDriver(${d.id})" style="color:var(--neon-pink); background:none; border:none; cursor:pointer; font-size:1.2rem; transition:0.3s;"><i class="fas fa-trash"></i></button></td>
                </tr>`;
            }).join('');
        }
    </script>
</body>
</html>

