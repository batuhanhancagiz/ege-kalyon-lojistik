                    </div>
                </div>

                <div class="panel-box">
                    <div class="panel-header">// FİLO DURUMU</div>
                    <ul class="stat-list">
                        <li class="stat-item"><span>TOPLAM ARAÇ</span> <b>14</b></li>
                        <li class="stat-item"><span>SEFERDE</span> <b style="color:var(--neon-green)">9</b></li>
                        <li class="stat-item"><span>BEKLEMEDE</span> <b style="color:var(--neon-yellow)">3</b></li>
