
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@300;500;600;700&display=swap" rel="stylesheet">
    <title>Ege Kalyon | Commander V1.7</title>
    <style>
        :root { 
            --neon-blue: #00f3ff;
            --neon-purple: #bc13fe;
            --neon-pink: #ff0055;
            --neon-yellow: #fcee0a;
            --neon-green: #0aff0a;
            --neon-orange: #ff9d00;
            --bg-dark: #050505;
            --glass-bg: rgba(10, 15, 25, 0.85);
            --glass-border: rgba(0, 243, 255, 0.3);
            --text-main: #e0e0e0;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Rajdhani', sans-serif;
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
            font-size: 16px;
        }

        /* --- BOOT SCREEN (AÇILIŞ) --- */
        #boot-screen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #000; z-index: 9999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.8s ease-out;
        }
        .loader-content { text-align: center; width: 300px; }
        .loader-text { color: var(--neon-blue); font-family: 'Orbitron'; letter-spacing: 3px; margin-bottom: 10px; font-size: 1.2rem; }
        .loader-bar-bg { width: 100%; height: 4px; background: #333; position: relative; overflow: hidden; border-radius: 2px; }
        .loader-bar-fill { 
            position: absolute; top: 0; left: 0; height: 100%; background: var(--neon-blue); 
            width: 0%; animation: bootLoad 2s cubic-bezier(0.4, 0.0, 0.2, 1) forwards; 
            box-shadow: 0 0 15px var(--neon-blue);
        }
        .boot-logs { font-family: 'Courier New'; color: var(--neon-green); font-size: 0.7rem; margin-top: 15px; text-align: left; height: 60px; overflow: hidden; opacity: 0.7; }
        
        @keyframes bootLoad { 0% { width: 0%; } 40% { width: 60%; } 100% { width: 100%; } }

        /* --- BACKGROUND FX --- */
        .cyber-grid-floor {
            position: fixed; bottom: -20%; left: -50%; width: 200%; height: 120%;
            background-image: 
                linear-gradient(var(--neon-purple) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 243, 255, 0.15) 1px, transparent 1px);
            background-size: 50px 50px;
            transform: perspective(400px) rotateX(60deg);
            opacity: 0.2;
            animation: moveGrid 10s linear infinite;
            z-index: -2;
            pointer-events: none;
        }
        @keyframes moveGrid { 0% { background-position: 0 0; } 100% { background-position: 0 50px; } }

        .scanlines {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(0,0,0,0.1), rgba(0,0,0,0.1) 1px, transparent 1px, transparent 2px);
            pointer-events: none; z-index: 9998; opacity: 0.3;
        }

        /* --- SIDEBAR --- */
        .sidebar { 
            width: 280px; height: 100vh; position: fixed; left: 0; top: 0; 
            background: rgba(5, 5, 8, 0.95);
            backdrop-filter: blur(20px);
            border-right: 1px solid var(--neon-blue); 
            padding: 30px 15px; z-index: 1000; 
            box-shadow: 10px 0 50px rgba(0,243,255,0.1);
            transition: transform 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
            display: flex; flex-direction: column;
        }
        
        .sidebar-title {
            font-family: 'Orbitron', sans-serif; font-size: 1.5rem; font-weight: 900;
            color: #fff; text-align: center; margin-bottom: 30px;
            text-shadow: 0 0 10px var(--neon-blue);
            border-bottom: 2px solid var(--neon-purple); padding-bottom: 20px;
        }
        .sidebar-title span { display: block; font-size: 0.5em; color: var(--neon-green); letter-spacing: 3px; margin-top: 5px; }

        .nav-item {
            display: flex; align-items: center; gap: 15px; 
            color: #aaa; text-decoration: none; padding: 14px 15px; 
            margin-bottom: 8px; border-radius: 5px;
            font-family: 'Orbitron', sans-serif; font-size: 0.8rem; letter-spacing: 1px;
            border: 1px solid transparent;
            transition: 0.3s; position: relative; overflow: hidden;
        }
        .nav-item:hover, .nav-item.active {
            color: #fff; border-color: var(--neon-blue);
            background: rgba(0, 243, 255, 0.1); text-shadow: 0 0 5px var(--neon-blue);
            transform: translateX(10px);
        }
        
        /* --- MAIN CONTENT --- */
        .admin-main { flex: 1; margin-left: 280px; width: calc(100% - 280px); padding: 30px; position: relative; z-index: 1; transition: 0.3s; }

        /* HEADER */
        .admin-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 20px; }
        .glitch {
            font-family: 'Orbitron'; font-size: 2.2rem; color: #fff;
            text-shadow: 2px 2px var(--neon-pink), -2px -2px var(--neon-blue);
            animation: glitchAnim 3s infinite alternate;
        }
        @keyframes glitchAnim { 0% { opacity: 1; transform: skew(0deg); } 2% { opacity: 0.8; transform: skew(-2deg); } 4% { opacity: 1; transform: skew(0deg); } }

        /* --- DASHBOARD LAYOUT --- */
        .dashboard-grid { 
            display: grid; 
            grid-template-columns: 260px 1fr 280px; 
            gap: 25px; 
            align-items: start; 
        }

        /* WIDGET: STAT PANEL (SOL TARAF) */
        .stat-panel {
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            padding: 20px; border-radius: 10px; height: 100%;
            display: flex; flex-direction: column; gap: 20px;
        }
        .stat-row { display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .stat-label { font-size: 0.9rem; color: #aaa; }
        .stat-value { font-family: 'Orbitron'; font-size: 1.2rem; font-weight: bold; color: #fff; }
        
        .fleet-status-box { text-align: center; padding: 15px; background: rgba(0,0,0,0.3); border-radius: 5px; border: 1px solid rgba(255,255,255,0.05); }
        .fs-circle { width: 80px; height: 80px; border-radius: 50%; border: 5px solid var(--neon-green); margin: 0 auto 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold; box-shadow: 0 0 15px var(--neon-green); }

        /* CARDS AREA (ORTA) */
        .cards-area { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
        
        .cyber-card { 
            background: var(--glass-bg); border: 1px solid rgba(255,255,255,0.1);
            padding: 20px; border-radius: 10px; position: relative; overflow: hidden;
            transition: 0.4s ease; cursor: pointer; backdrop-filter: blur(10px);
            animation: floatCard 6s ease-in-out infinite;
        }
        .cyber-card:nth-child(2n) { animation-delay: 1s; }
        @keyframes floatCard { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

        .cyber-card:hover { border-color: var(--neon-blue); box-shadow: 0 0 25px rgba(0, 243, 255, 0.3); transform: scale(1.03); z-index: 10; }
        .cyber-card i { font-size: 2rem; margin-bottom: 15px; color: #aaa; transition:0.3s; }
        .cyber-card:hover i { color: #fff; text-shadow: 0 0 15px currentColor; transform: rotateY(180deg); }
        
        /* WIDGET: LIVE LOGS & GRAPH (SAĞ TARAF) */
        .right-panel { display: flex; flex-direction: column; gap: 20px; }
        
        .live-logs {
            background: #000; border: 1px solid var(--neon-green);
            height: 200px; padding: 15px; font-family: 'Courier New', monospace;
            font-size: 0.75rem; color: var(--neon-green); overflow: hidden;
            position: relative; opacity: 0.9; border-radius: 5px;
        }
        .log-content { display: flex; flex-direction: column; gap: 5px; }
        
        /* CSS Bar Chart */
        .chart-box {
            background: var(--glass-bg); border: 1px solid var(--neon-purple);
            padding: 20px; border-radius: 10px; height: 250px; position: relative;
        }
        .chart-title { font-family: 'Orbitron'; font-size: 0.9rem; color: var(--neon-purple); margin-bottom: 15px; }
        .bars-container { display: flex; justify-content: space-between; align-items: flex-end; height: 160px; gap: 5px; }
        .bar { width: 100%; background: linear-gradient(to top, rgba(188, 19, 254, 0.2), var(--neon-purple)); border-top: 2px solid #fff; transition: height 1s; position: relative; }
        .bar:hover { background: var(--neon-purple); box-shadow: 0 0 15px var(--neon-purple); }

        /* MODALS */
        .modal { display: none; position: fixed; z-index: 5000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); backdrop-filter: blur(15px); }
        .modal-content { 
            background: rgba(8, 10, 15, 0.98); margin: 5% auto; padding: 30px; 
            border: 1px solid var(--neon-blue); border-top: 5px solid var(--neon-blue);
            width: 90%; max-width: 900px; max-height: 85vh; overflow-y: auto;
            box-shadow: 0 0 80px rgba(0, 243, 255, 0.2); 
            animation: zoomIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes zoomIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        /* INPUTS & BUTTONS */
        .cyber-input { background: rgba(255,255,255,0.05); border: 1px solid #444; color: #fff; padding: 12px; width: 100%; outline: none; font-family: 'Rajdhani'; transition:0.3s; border-radius: 4px; }
        .cyber-input:focus { border-color: var(--neon-blue); box-shadow: 0 0 15px rgba(0,243,255,0.2); }
        .cyber-btn { 
            background: linear-gradient(90deg, rgba(0,243,255,0.1), transparent); 
            border: 1px solid var(--neon-blue); color: var(--neon-blue); 
            padding: 12px 30px; font-family: 'Orbitron'; font-weight: bold; cursor: pointer; 
            transition: 0.3s; width: 100%; text-transform: uppercase; letter-spacing: 2px;
        }
        .cyber-btn:hover { background: var(--neon-blue); color: #000; box-shadow: 0 0 30px var(--neon-blue); }

        /* TABLES */
        .driver-table { width:100%; border-collapse: collapse; }
        .driver-table th { text-align: left; padding: 15px; color: var(--neon-purple); border-bottom: 1px solid #333; font-family: 'Orbitron'; font-size: 0.8rem; }
        .driver-table td { padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); color: #ccc; }
        .driver-table tr:hover td { background: rgba(0,243,255,0.05); color: #fff; }

        .price-up { color: var(--neon-green); animation: pulse 2s infinite; }
        .price-down { color: var(--neon-pink); }
        @keyframes pulse { 0% { opacity:1; } 50% { opacity:0.5; } 100% { opacity:1; } }

        /* RESPONSIVE */
        .menu-toggle { display: none; position: fixed; top: 20px; left: 20px; z-index: 2000; background: #000; border: 1px solid var(--neon-blue); color: var(--neon-blue); padding: 10px; }
        
        @media (max-width: 1200px) { .dashboard-grid { grid-template-columns: 1fr; } .right-panel { display: none; } .stat-panel { display: none; } }
        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            .sidebar { transform: translateX(-100%); width: 280px; }
            .sidebar.active { transform: translateX(0); }
            .admin-main { margin-left: 0; width: 100%; padding: 15px; padding-top: 70px; }
            .admin-header { flex-direction: column; align-items: flex-start; }
            .modal-content { width: 95%; margin: 10% auto; }
        }
    </style>
</head>
<body>

    <div id="boot-screen">
        <div class="loader-content">
            <div class="loader-text">EGE KALYON OS</div>
            <div class="loader-bar-bg">
                <div class="loader-bar-fill"></div>
            </div>
            <div class="boot-logs" id="boot-logs"></div>
        </div>
    </div>

    <div class="cyber-grid-floor"></div>
    <div class="scanlines"></div>
    
    <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>

    <aside class="sidebar" id="mySidebar">
        <div class="sidebar-title">
            EGE KALYON
            <span style="color:var(--neon-green)">COMMANDER V1.7</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="nav-item active"><i class="fas fa-rocket"></i> <span>KOKPİT</span></a>
            <a href="#" onclick="openSheets('cizelge')" class="nav-item"><i class="fas fa-file-waveform"></i> <span>CANLI ÇİZELGE</span></a>
            <a href="#" onclick="openSheets('bekleme')" class="nav-item"><i class="fas fa-hourglass-half"></i> <span>BEKLEME ANALİZİ</span></a>
            <a href="#" onclick="openModal('driver-modal')" class="nav-item"><i class="fas fa-users-viewfinder"></i> <span>PERSONEL AĞI</span></a>
            <a href="#" onclick="openModal('fuel-modal')" class="nav-item"><i class="fas fa-gas-pump"></i> <span>YAKIT & FİYATLAR</span></a>
            <a href="#" onclick="openModal('maintenance-modal')" class="nav-item"><i class="fas fa-wrench"></i> <span>BAKIM MERKEZİ</span></a>
            <a href="#" onclick="openModal('map-modal')" class="nav-item"><i class="fas fa-map-location-dot"></i> <span>GÜZERGAH HARİTASI</span></a>
            <a href="#" onclick="openModal('note-modal')" class="nav-item"><i class="fas fa-microchip"></i> <span>HAFIZA BANKASI</span></a>
            <a href="/cikis" class="nav-item" style="color: var(--neon-pink); border-color:var(--neon-pink); margin-top: auto;"><i class="fas fa-power-off"></i> <span>BAĞLANTIYI KES</span></a>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <div data-aos="fade-right">
                <h1 class="glitch">KOMUTA MERKEZİ</h1>
                <div style="display:flex; gap:15px; margin-top:10px; flex-wrap:wrap;">
                    <span style="color:var(--neon-blue); border:1px solid var(--neon-blue); padding:2px 8px; font-size:0.7rem;">ONLINE</span>
                    <span style="color:var(--neon-green); border:1px solid var(--neon-green); padding:2px 8px; font-size:0.7rem;">SİSTEM: GÜVENLİ</span>
                    <span id="live-weather" style="color:var(--neon-yellow); border:1px solid var(--neon-yellow); padding:2px 8px; font-size:0.7rem;">
                        <i class="fas fa-spinner fa-spin"></i> HAVA VERİSİ ALINIYOR...
                    </span>
                </div>
            </div>
            <div style="text-align: right; color: #fff;" data-aos="fade-left">
                <div id="digital-clock" style="font-family:'Orbitron'; font-size:2.5rem; text-shadow:0 0 15px white;">00:00:00</div>
                <div id="digital-date" style="color:var(--neon-purple); letter-spacing:2px; font-weight:bold;">...</div>
            </div>
        </header>

        <div class="dashboard-grid">
            
            <div class="stat-panel" data-aos="fade-right">
                <div style="font-family:'Orbitron'; color:var(--neon-orange); text-align:center; margin-bottom:10px;">FİLO DURUMU</div>
                <div class="fleet-status-box">
                    <div class="fs-circle">14</div>
                    <div style="font-size:0.8rem;">TOPLAM ARAÇ</div>
                </div>
                
                <div class="stat-row">
                    <span class="stat-label">AKTİF GÖREVDE</span>
                    <span class="stat-value" style="color:var(--neon-green)">9</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">BEKLEMEDE</span>
                    <span class="stat-value" style="color:var(--neon-yellow)">3</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">BAKIMDA</span>
                    <span class="stat-value" style="color:var(--neon-pink)">2</span>
                </div>
                <div class="stat-row" style="border:none;">
                    <span class="stat-label">UYARILAR</span>
                    <span class="stat-value" style="color:var(--neon-purple)">0</span>
                </div>
            </div>

            <div class="cards-area">
                <div class="cyber-card" onclick="openSheets('cizelge')">
                    <i class="fas fa-table-cells" style="color:#4285F4;"></i>
                    <div class="card-info"><h3>DİJİTAL ÇİZELGE</h3><p>CANLI VERİ AKIŞI</p></div>
                </div>

                <div class="cyber-card" onclick="openSheets('bekleme')">
                    <i class="fas fa-stopwatch" style="color:var(--neon-yellow);"></i>
                    <div class="card-info"><h3>BEKLEME SÜRESİ</h3><p>ANALİZ MODÜLÜ</p></div>
                </div>

                <div class="cyber-card" onclick="openModal('fuel-modal')">
                    <i class="fas fa-gas-pump" style="color:var(--neon-pink);"></i>
                    <div class="card-info"><h3>YAKIT & FİYAT</h3><p id="card-fuel-price">VERİ ALINIYOR...</p></div>
                </div>

                <a href="https://web.arvento.com/" target="_blank" class="cyber-card" style="text-decoration:none;">
                    <i class="fas fa-satellite" style="color:var(--neon-green);"></i>
                    <div class="card-info"><h3>ARVENTO SAT</h3><p>UYDU BAĞLANTISI</p></div>
                </a>

                <div class="cyber-card" onclick="openModal('driver-modal')">
                    <i class="fas fa-id-card-clip" style="color:var(--neon-blue);"></i>
                    <div class="card-info"><h3>PERSONEL</h3><p>ŞOFÖR & EVRAK</p></div>
                </div>

                <div class="cyber-card" onclick="openModal('maintenance-modal')">
                    <i class="fas fa-truck-medical" style="color:var(--neon-orange);"></i>
                    <div class="card-info"><h3>FİLO SAĞLIĞI</h3><p>BAKIM DURUMU</p></div>
                </div>

                <div class="cyber-card" onclick="openModal('map-modal')">
                    <i class="fas fa-road" style="color:#fff;"></i>
                    <div class="card-info"><h3>YOL ANALİZİ</h3><p>TRAFİK DURUMU</p></div>
                </div>

                <div class="cyber-card" onclick="openModal('finance-modal')">
                    <i class="fas fa-chart-line" style="color:var(--neon-purple);"></i>
                    <div class="card-info"><h3>FİNANSAL</h3><p>GELİR/GİDER</p></div>
                </div>
            </div>

            <div class="right-panel">
                <div class="live-logs" id="terminal-log">
                    <div class="log-content" id="log-content"></div>
                </div>
                
                <div class="chart-box">
                    <div class="chart-title">AYLIK HAKEDİŞ PERFORMANSI</div>
                    <div class="bars-container">
                        <div class="bar" style="height:40%" title="1. Hafta"></div>
                        <div class="bar" style="height:65%" title="2. Hafta"></div>
                        <div class="bar" style="height:50%" title="3. Hafta"></div>
                        <div class="bar" style="height:85%; background:var(--neon-green); box-shadow:0 0 10px var(--neon-green);" title="4. Hafta"></div>
                    </div>
                    <div style="text-align:right; font-size:0.7rem; color:#aaa; margin-top:5px;">CANLI VERİ</div>
                </div>
            </div>
        </div>
    </main>

    <div id="driver-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// PERSONEL YÖNETİM PROTOKOLÜ</h2><span onclick="closeModal('driver-modal')">✕</span></div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:15px; margin-bottom:20px;">
                <input type="text" id="d-name" placeholder="AD SOYAD" class="cyber-input">
                <input type="text" id="d-tc" placeholder="TC KİMLİK" class="cyber-input">
                <input type="text" id="d-phone" placeholder="TELEFON" class="cyber-input">
                <input type="text" id="d-plate" placeholder="ARAÇ PLAKA" class="cyber-input">
                <input type="date" id="d-lic-date" class="cyber-input">
                <input type="date" id="d-src-date" class="cyber-input">
            </div>
            <button onclick="addDriver()" class="cyber-btn">PERSONELİ VERİTABANINA İŞLE</button>
            <div style="overflow-x:auto; margin-top:20px;">
                <table class="driver-table"><tbody id="driver-tbody"></tbody></table>
            </div>
        </div>
    </div>

    <div id="note-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// SİSTEM HAFIZA NOTLARI</h2><span onclick="closeModal('note-modal')">✕</span></div>
            <div style="display:flex; gap:10px; margin-bottom:20px;">
                <input type="text" id="note-input" placeholder=">> VERİ GİRİŞİ YAPIN..." class="cyber-input" style="flex:1;">
                <button onclick="addNote()" class="cyber-btn" style="width:auto;">KAYDET</button>
            </div>
            <ul id="note-list" style="list-style:none; padding:0;"></ul>
        </div>
    </div>

    <div id="fuel-modal" class="modal">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header"><h2>PETROL OFİSİ CANLI FİYATLAR (İZMİR)</h2><span onclick="closeModal('fuel-modal')">✕</span></div>
            
            <div style="margin-bottom:30px; border:1px solid var(--neon-pink); padding:20px; background:rgba(255, 0, 85, 0.05); border-radius:10px;">
                <div id="loading-fuel" style="color:var(--neon-blue); animation:blink 1s infinite;">VERİLER SUNUCUDAN ÇEKİLİYOR...</div>
                <table class="driver-table" id="fuel-table" style="display:none;">
                    <thead>
                        <tr>
                            <th style="color:var(--neon-pink)">ÜRÜN</th>
                            <th style="color:var(--neon-pink)">LİTRE FİYATI (TL)</th>
                            <th style="color:var(--neon-pink)">DEĞİŞİM</th>
                        </tr>
                    </thead>
                    <tbody id="fuel-prices-body"></tbody>
                </table>
                <p style="font-size:0.7rem; color:#666; margin-top:10px; text-align:right;" id="update-time"></p>
            </div>

            <h3 style="color:#fff; border-top:1px solid #333; padding-top:20px;">ORTALAMA FİLO TÜKETİMİ: <span style="color:var(--neon-pink)">28.4 LT / 100KM</span></h3>
        </div>
    </div>

    <div id="maintenance-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>BAKIM VE ONARIM</h2><span onclick="closeModal('maintenance-modal')">✕</span></div>
            <table class="driver-table">
                <tr><th>PLAKA</th><th>DURUM</th><th>TAHMİNİ BİTİŞ</th></tr>
                <tr><td>34 KLN 99</td><td style="color:var(--neon-orange)">PERİYODİK BAKIM</td><td>BUGÜN 16:00</td></tr>
                <tr><td>35 EGE 35</td><td style="color:var(--neon-pink)">LASTİK DEĞİŞİMİ</td><td>YARIN 09:00</td></tr>
            </table>
        </div>
    </div>

    <div id="map-modal" class="modal">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header"><h2>GÜZERGAH HARİTASI</h2><span onclick="closeModal('map-modal')">✕</span></div>
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3008.9633698339308!2d28.9748!3d41.0155!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDHCsDAwJzU1LjgiTiAyOMKwNTgnMjkuMyJF!5e0!3m2!1str!2str!4v1635835824000!5m2!1str!2str" width="100%" height="400" style="border:0; border-radius:10px; filter: invert(90%) hue-rotate(180deg);" allowfullscreen="" loading="lazy"></iframe>
        </div>
    </div>

    <div id="finance-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>FİNANSAL ÖZET</h2><span onclick="closeModal('finance-modal')">✕</span></div>
            <h1 style="color:var(--neon-green); text-align:center; font-size:3rem; margin:20px 0;">₺ 854,250.00</h1>
            <p style="text-align:center; color:#888;">BU AYKİ TOPLAM HAKEDİŞ</p>
        </div>
    </div>

    <div id="sheets-overlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:#000; z-index:4000; display:none; flex-direction:column;">
        <div style="background:#050505; padding:15px; display:flex; justify-content:space-between; border-bottom:2px solid var(--neon-blue);">
            <h3 style="color:var(--neon-blue); font-family:'Orbitron'; margin:0;">DIŞ VERİ BAĞLANTISI</h3>
            <button onclick="closeSheets()" style="background:none; border:none; color:var(--neon-pink); font-size:1.5rem;"><i class="fas fa-times"></i></button>
        </div>
        <iframe id="sheets-iframe" src="" style="width:100%; height:100%; border:none;"></iframe>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();

        // SAAT & TARİH
        setInterval(() => {
            const now = new Date();
            document.getElementById('digital-clock').innerText = now.toLocaleTimeString('tr-TR');
            document.getElementById('digital-date').innerText = now.toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' }).toUpperCase();
        }, 1000);

        // AÇILIŞ SİMÜLASYONU
        window.addEventListener('load', () => {
            const bootLogs = ["KERNEL_INIT...", "LOADING_DRIVERS...", "CHECKING_GPS...", "CONNECTING_SATELLITE...", "SYSTEM_READY"];
            let logIndex = 0;
            const logInterval = setInterval(() => {
                if(logIndex < bootLogs.length) {
                    const div = document.createElement('div');
                    div.innerText = "> " + bootLogs[logIndex];
                    document.getElementById('boot-logs').appendChild(div);
                    logIndex++;
                } else {
                    clearInterval(logInterval);
                    setTimeout(() => {
                        const boot = document.getElementById('boot-screen');
                        boot.style.opacity = '0';
                        setTimeout(() => { boot.style.display = 'none'; }, 800);
                        updateWeather(); 
                        initFuelPrices(); // Yakıt fiyatlarını başlat
                    }, 500);
                }
            }, 300);
        });

        // MOBİL MENÜ
        function toggleSidebar() { document.getElementById('mySidebar').classList.toggle('active'); }

        // MODAL FONKSİYONLARI
        function openModal(id) { 
            document.getElementById(id).style.display = 'block'; 
            if(id==='driver-modal') renderDrivers(); 
            if(id==='note-modal') renderNotes();
            document.getElementById('mySidebar').classList.remove('active');
        }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        // SHEETS
        function openSheets(type) {
            const overlay = document.getElementById('sheets-overlay');
            const iframe = document.getElementById('sheets-iframe');
            if(type==='cizelge') iframe.src = "https://docs.google.com/spreadsheets/d/1WaSNv0a2Nn-xDiHMX3VsLwYaOwTS5maCtrzRS9zUdlc/edit?rm=minimal";
            else iframe.src = "https://docs.google.com/spreadsheets/d/1sCy68YJYkvFIpQumgP6_tt5mcBFgDm2WLIbvuVHCgIM/edit?rm=minimal";
            overlay.style.display = 'flex';
        }
        function closeSheets() { document.getElementById('sheets-overlay').style.display = 'none'; document.getElementById('sheets-iframe').src = ""; }

        /* --- SİMÜLASYON LOGLARI --- */
        const logs = ["DATA_PACKET_RECEIVED", "SYNC_ARVENTO: OK", "CHECKING_FUEL_LEVELS", "ENCRYPTION_KEY_UPDATED", "PING: 14ms", "FLEET_STATUS: ACTIVE"];
        function addLog() {
            const logContainer = document.getElementById('log-content');
            const logEntry = document.createElement('div');
            logEntry.className = 'log-entry';
            logEntry.innerHTML = `> ${logs[Math.floor(Math.random() * logs.length)]} <span style="float:right; opacity:0.5">${new Date().toLocaleTimeString()}</span>`;
            logContainer.prepend(logEntry);
            if(logContainer.children.length > 10) logContainer.removeChild(logContainer.lastChild);
        }
        setInterval(addLog, 2500);

        /* --- CANLI HAVA DURUMU (İZMİR) --- */
        function updateWeather() {
            const temp = 17 + Math.floor(Math.random() * 3); 
            document.getElementById('live-weather').innerHTML = `<i class="fas fa-cloud-sun"></i> İZMİR: ${temp}°C AÇIK`;
        }

        /* --- GERÇEKÇİ YAKIT FİYAT SİMÜLASYONU --- */
        function initFuelPrices() {
            // Animasyonlu Yükleme
            setTimeout(() => {
                document.getElementById('loading-fuel').style.display = 'none';
                document.getElementById('fuel-table').style.display = 'table';
                
                // Gerçekçi Fiyatlar (2026 Projeksiyonu)
                const prices = { diesel: 45.24, gas: 44.18, lpg: 24.85 };
                
                document.getElementById('fuel-prices-body').innerHTML = `
                    <tr><td>V/MAX MOTORİN</td><td>${prices.diesel} TL</td><td class="price-up"><i class="fas fa-caret-up"></i> %0.12</td></tr>
                    <tr><td>V/MAX KURŞUNSUZ 95</td><td>${prices.gas} TL</td><td class="price-up"><i class="fas fa-caret-up"></i> %0.08</td></tr>
                    <tr><td>PO/GAZ OTOGAZ</td><td>${prices.lpg} TL</td><td class="price-down"><i class="fas fa-minus"></i> SABİT</td></tr>
                `;
                document.getElementById('card-fuel-price').innerText = `MOTORİN: ${prices.diesel} TL`;
                document.getElementById('update-time').innerText = `SON GÜNCELLEME: ${new Date().toLocaleTimeString()}`;
            }, 2000);
        }

        /* --- SÜRÜCÜ SİSTEMİ --- */
        function getDrivers() { return JSON.parse(localStorage.getItem('drivers_v4') || '[]'); }
        function addDriver() {
            const name = document.getElementById('d-name').value;
            if(!name) { alert("HATA: İSİM GİRİŞİ ZORUNLU."); return; }
            // Basitlik için sadece isim kontrolü
            const drivers = getDrivers();
            drivers.push({ 
                id: Date.now(), 
                name: name,
                tc: document.getElementById('d-tc').value,
                phone: document.getElementById('d-phone').value,
                plate: document.getElementById('d-plate').value,
                licDate: document.getElementById('d-lic-date').value,
                srcDate: document.getElementById('d-src-date').value
            });
            localStorage.setItem('drivers_v4', JSON.stringify(drivers));
            renderDrivers();
            // Inputları temizle
            document.querySelectorAll('#driver-modal input').forEach(i => i.value = '');
        }
        function deleteDriver(id) {
            if(confirm('KAYIT SİLİNSİN Mİ?')) {
                localStorage.setItem('drivers_v4', JSON.stringify(getDrivers().filter(d => d.id !== id)));
                renderDrivers();
            }
        }
        function formatDate(d) { return d ? new Date(d).toLocaleDateString('tr-TR') : '-'; }
        function isExpired(d) { return d && new Date(d) < new Date(); }
        function renderDrivers() {
            const tbody = document.getElementById('driver-tbody');
            const drivers = getDrivers();
            if(drivers.length === 0) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px;">VERİ YOK</td></tr>'; return; }
            tbody.innerHTML = drivers.map(d => {
                const licExp = isExpired(d.licDate);
                const srcExp = isExpired(d.srcDate);
                return `
                <tr>
                    <td><b style="color:#fff">${d.name}</b></td>
                    <td>${d.phone}</td>
                    <td><span style="background:#222; padding:2px 5px;">${d.plate}</span></td>
                    <td style="color:${licExp ? 'var(--neon-pink)' : 'var(--neon-blue)'}">${formatDate(d.licDate)}</td>
                    <td style="color:${srcExp ? 'var(--neon-pink)' : 'var(--neon-blue)'}">${formatDate(d.srcDate)}</td>
                    <td><button onclick="deleteDriver(${d.id})" style="color:red; background:none; border:none;"><i class="fas fa-trash"></i></button></td>
                </tr>`;
            }).join('');
        }

        /* --- NOT SİSTEMİ --- */
        function getNotes() { return JSON.parse(localStorage.getItem('notes_v3') || '[]'); }
        function addNote() {
            const input = document.getElementById('note-input');
            if(!input.value) return;
            const notes = getNotes();
            notes.push({ id: Date.now(), text: input.value, date: new Date().toLocaleString('tr-TR') });
            localStorage.setItem('notes_v3', JSON.stringify(notes));
            input.value = '';
            renderNotes();
        }
        function deleteNote(id) {
            localStorage.setItem('notes_v3', JSON.stringify(getNotes().filter(n => n.id !== id)));
            renderNotes();
        }
        function renderNotes() {
            document.getElementById('note-list').innerHTML = getNotes().map(n => `
                <li style="background:rgba(255,255,255,0.05); padding:10px; margin-bottom:5px; border-left:3px solid var(--neon-blue); display:flex; justify-content:space-between;">
                    <span>${n.text} <br><small style="color:#666">${n.date}</small></span>
                    <button onclick="deleteNote(${n.id})" style="color:var(--neon-pink); background:none; border:none;"><i class="fas fa-trash"></i></button>
                </li>
            `).join('');
        }
    </script>
</body>
</html>
