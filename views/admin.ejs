<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@300;500;700&display=swap" rel="stylesheet">
    <title>Ege Kalyon | Terminal V2.4 NEXT-GEN</title>
    <style>
        :root { 
            --cyber-cyan: #00f0ff;
            --cyber-yellow: #fcee0a;
            --cyber-red: #ff003c;
            --cyber-black: #050505;
            --cyber-dark-glass: rgba(10, 10, 15, 0.85);
            --border-color: rgba(0, 240, 255, 0.3);
            --hud-color: #00f0ff;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background-color: var(--cyber-black);
            color: #fff;
            font-family: 'Rajdhani', sans-serif; /* Daha teknik bir font */
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
            font-size: 16px;
        }

        /* ARKA PLAN EFEKTLERİ */
        body::before {
            content: ""; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: 
                linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 2px, 3px 100%;
            z-index: 999; pointer-events: none; opacity: 0.6;
        }

        .bg-grid {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(var(--border-color) 1px, transparent 1px),
                linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
            background-size: 50px 50px;
            opacity: 0.1;
            z-index: -2;
            transform: perspective(500px) rotateX(60deg) translateY(-100px) scale(2);
            animation: planeMove 20s linear infinite;
        }

        @keyframes planeMove { from { background-position: 0 0; } to { background-position: 0 100px; } }

        /* SCROLLBAR */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #000; }
        ::-webkit-scrollbar-thumb { background: var(--cyber-cyan); border-radius: 0; }

        /* SIDEBAR - MECHA STİLİ */
        .sidebar { 
            width: 300px; height: 100vh; position: fixed; left: 0; top: 0; 
            background: var(--cyber-black); 
            border-right: 2px solid var(--cyber-cyan); 
            padding: 40px 20px; z-index: 100; 
            clip-path: polygon(0 0, 100% 0, 100% 95%, 85% 100%, 0 100%);
        }
        
        .sidebar-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem; font-weight: 900;
            color: var(--cyber-yellow);
            text-shadow: 0 0 10px var(--cyber-yellow);
            margin-bottom: 60px;
            padding-left: 10px;
            border-left: 5px solid var(--cyber-red);
            line-height: 1;
        }

        .nav-item {
            display: flex; align-items: center; gap: 15px; 
            color: #888; text-decoration: none; padding: 18px 20px; 
            margin-bottom: 15px; 
            font-family: 'Orbitron', sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
            border: 1px solid transparent;
            transition: 0.3s;
            position: relative;
            background: rgba(255,255,255,0.02);
            clip-path: polygon(0 0, 100% 0, 100% 70%, 90% 100%, 0 100%);
        }

        .nav-item:hover, .nav-item.active {
            background: var(--cyber-cyan);
            color: #000;
            box-shadow: 0 0 20px var(--cyber-cyan);
            padding-left: 30px;
        }
        
        /* CONTENT AREA */
        .admin-main { flex: 1; margin-left: 300px; min-height: 100vh; display: flex; flex-direction: column; width: calc(100% - 300px); position: relative; z-index: 1; }
        .content-wrapper { padding: 50px; flex: 1; }

        /* HEADER */
        .glitch-wrapper { margin-bottom: 10px; }
        .glitch {
            font-family: 'Orbitron', sans-serif; font-size: 3rem; font-weight: 900; color: #fff; text-transform: uppercase;
            text-shadow: 2px 2px var(--cyber-red), -2px -2px var(--cyber-cyan);
            letter-spacing: -2px;
        }
        
        #digital-clock { 
            font-family: 'Orbitron', sans-serif; 
            font-size: 3.5rem; color: #fff; 
            font-weight: 900;
            text-shadow: 0 0 20px rgba(255,255,255,0.5);
            line-height: 1;
        }
        #digital-date { color: var(--cyber-yellow); letter-spacing: 5px; font-weight: 700; text-align: right; font-family: 'Orbitron'; font-size: 0.9rem; margin-top: 5px; }

        /* CYBER CARDS - ANGLED DESIGN */
        .grid-cockpit-v2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px; margin-top: 50px; }
        
        .cyber-card { 
            background: rgba(20, 20, 25, 0.7); 
            border: 1px solid var(--border-color); 
            padding: 30px; 
            transition: 0.3s; 
            cursor: pointer;
            position: relative;
            /* Köşeleri Kesik Yapı */
            clip-path: polygon(
                20px 0, 100% 0, 
                100% calc(100% - 20px), calc(100% - 20px) 100%, 
                0 100%, 0 20px
            );
            backdrop-filter: blur(10px);
        }

        .cyber-card::before {
            content: "SYS-READY"; position: absolute; top: 10px; right: 10px;
            font-size: 0.6rem; color: var(--border-color); font-family: 'Orbitron'; letter-spacing: 2px;
        }

        .cyber-card:hover { 
            background: rgba(0, 240, 255, 0.1); 
            border-color: var(--cyber-cyan);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }
        
        .cyber-card:hover i { color: #fff !important; text-shadow: 0 0 15px var(--cyber-cyan); transform: scale(1.1); }
        .cyber-card i { font-size: 2.5rem; margin-bottom: 20px; transition: 0.3s; display: block; }
        .card-info h3 { font-family: 'Orbitron', sans-serif; font-size: 1.4rem; color: #fff; margin-bottom: 5px; text-transform: uppercase; }
        .card-info p { color: var(--cyber-cyan); font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase; font-weight: 600; }

        /* MODAL STYLES - HUD WINDOW */
        .modal { display: none; position: fixed; z-index: 3000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); backdrop-filter: blur(15px); }
        .modal-content { 
            background: #09090b; margin: 3% auto; padding: 40px; 
            border: 1px solid var(--cyber-cyan); 
            width: 90%; max-width: 1000px; 
            box-shadow: 0 0 100px rgba(0, 240, 255, 0.15); 
            position: relative;
            /* Karmaşık HUD Şekli */
            clip-path: polygon(
                0 0, 100% 0, 
                100% calc(100% - 30px), calc(100% - 30px) 100%, 
                30px 100%, 0 calc(100% - 30px)
            );
        }
        
        /* Dekoratif Çizgiler */
        .modal-content::after {
            content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 5px; background: var(--cyber-cyan);
        }

        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; border-bottom: 1px solid #333; padding-bottom: 20px; }
        .modal-header h2 { font-family: 'Orbitron'; font-size: 2rem; color: var(--cyber-cyan); text-transform: uppercase; letter-spacing: 3px; }
        .modal-header span { color: var(--cyber-red); font-size: 2rem; cursor: pointer; transition: 0.3s; }
        .modal-header span:hover { transform: rotate(90deg); }

        /* INPUTS - COMMAND LINE STYLE */
        .cyber-input {
            background: rgba(255,255,255,0.03); 
            border: none;
            border-bottom: 2px solid #333; 
            color: #fff; 
            padding: 15px; 
            width: 100%; 
            outline: none;
            font-family: 'Rajdhani', monospace;
            font-size: 1.1rem;
            font-weight: 600;
            transition: 0.3s;
        }
        .cyber-input:focus { border-bottom-color: var(--cyber-cyan); background: rgba(0, 240, 255, 0.05); }
        .cyber-input::placeholder { color: #555; text-transform: uppercase; }

        /* BUTTONS - GLITCH STYLE */
        .cyber-btn {
            background: transparent;
            border: 1px solid var(--cyber-cyan);
            color: var(--cyber-cyan);
            padding: 15px 40px;
            font-family: 'Orbitron';
            font-weight: 900;
            cursor: pointer;
            transition: 0.2s;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            overflow: hidden;
            clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
        }
        .cyber-btn:hover {
            background: var(--cyber-cyan);
            color: #000;
            box-shadow: 0 0 30px var(--cyber-cyan);
        }

        /* TABLES - DATA LIST STYLE */
        .driver-table { width:100%; border-collapse:separate; border-spacing: 0 10px; margin-top: 20px; }
        .driver-table th { text-align: left; padding: 20px; color: #666; font-family: 'Orbitron'; letter-spacing: 1px; font-size: 0.8rem; text-transform: uppercase; }
        .driver-table td { padding: 20px; background: rgba(255,255,255,0.03); border: 1px solid transparent; color: #ccc; font-weight: 500; }
        .driver-table tr { transition: 0.2s; }
        .driver-table tr:hover td { border-color: var(--cyber-cyan); background: rgba(0, 240, 255, 0.05); color: #fff; }
        .driver-table tr td:first-child { border-left: 3px solid transparent; }
        .driver-table tr:hover td:first-child { border-left-color: var(--cyber-cyan); }
        
        .expired-warning { color: var(--cyber-red) !important; font-weight: 900; text-shadow: 0 0 10px var(--cyber-red); animation: blink 1s infinite; }
        @keyframes blink { 50% { opacity: 0.3; } }

        /* FOOTER */
        .admin-footer { padding: 30px; border-top: 1px solid #111; text-align: center; color: #444; font-family: 'Orbitron'; font-size: 0.7rem; letter-spacing: 2px; }

        @media (max-width: 1024px) {
            .sidebar { width: 80px; padding: 20px 10px; clip-path: none; border-right: 1px solid #333; }
            .sidebar-title, .sidebar-nav a span { display: none; }
            .admin-main { margin-left: 80px; width: calc(100% - 80px); }
        }
    </style>
</head>
<body>
    <div class="bg-grid"></div>

    <aside class="sidebar">
        <div class="sidebar-title">EGE KALYON <br><span style="font-size:0.5em; color:var(--cyber-cyan)">SYSTEM V4.0</span></div>
        <nav class="sidebar-nav">
            <a href="/admin" class="nav-item active"><i class="fas fa-microchip"></i> <span>KOKPİT</span></a>
            <a href="#" onclick="openSheets('cizelge')" class="nav-item"><i class="fas fa-table"></i> <span>VERİ AKIŞI</span></a>
            <a href="#" onclick="openSheets('bekleme')" class="nav-item"><i class="fas fa-hourglass-half"></i> <span>HAKEDİŞ</span></a>
            <a href="#" onclick="openModal('driver-modal')" class="nav-item"><i class="fas fa-users-viewfinder"></i> <span>PERSONEL</span></a>
            <a href="#" onclick="openModal('note-modal')" class="nav-item"><i class="fas fa-sd-card"></i> <span>HAFIZA</span></a>
            <a href="/cikis" class="nav-item" style="color: var(--cyber-red); margin-top: 50px;"><i class="fas fa-power-off"></i> <span>OTURUMU KAPAT</span></a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="content-wrapper">
            <header class="admin-header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 60px;">
                <div data-aos="fade-right">
                    <div class="glitch-wrapper">
                        <h1 class="glitch">OPERASYON WEB</h1>
                    </div>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div style="width:10px; height:10px; background:var(--cyber-cyan); box-shadow:0 0 10px var(--cyber-cyan); border-radius:50%;"></div>
                        <p style="color: var(--cyber-cyan); font-family: 'Orbitron'; letter-spacing: 2px; font-size: 0.9rem;">GÜVENLİ BAĞLANTI KURULDU // EGE KALYON</p>
                    </div>
                </div>
                <div style="text-align: right;" data-aos="fade-left">
                    <div id="digital-clock">00:00:00</div>
                    <div id="digital-date">...</div>
                </div>
            </header>

            <section class="grid-cockpit-v2">
                <div class="cyber-card" onclick="openSheets('cizelge')" data-aos="fade-up" data-aos-delay="100">
                    <i class="fas fa-file-waveform" style="color: #4285F4;"></i>
                    <div class="card-info"><h3>DİJİTAL ÇİZELGE</h3><p>ANALİTİK VERİ</p></div>
                </div>

                <div class="cyber-card" onclick="openSheets('bekleme')" data-aos="fade-up" data-aos-delay="200">
                    <i class="fas fa-stopwatch-20" style="color: var(--cyber-yellow);"></i>
                    <div class="card-info"><h3>BEKLEME MODÜLÜ</h3><p>CANLI SAYAÇ</p></div>
                </div>

                <a href="https://web.arvento.com/" target="_blank" class="cyber-card" style="text-decoration:none;" data-aos="fade-up" data-aos-delay="300">
                    <i class="fas fa-satellite" style="color: var(--cyber-red);"></i>
                    <div class="card-info"><h3>ARVENTO SAT</h3><p>UYDU İZLEME</p></div>
                </a>

                <a href="https://www.luca.com.tr/" target="_blank" class="cyber-card" style="text-decoration:none;" data-aos="fade-up" data-aos-delay="400">
                    <i class="fas fa-chart-pie" style="color: #d946ef;"></i>
                    <div class="card-info"><h3>LUCA FİNANS</h3><p>MALİ PROTOKOL</p></div>
                </a>

                <div class="cyber-card" onclick="openModal('driver-modal')" style="border-color: var(--cyber-cyan);" data-aos="fade-up" data-aos-delay="500">
                    <i class="fas fa-id-card-clip" style="color: var(--cyber-cyan);"></i>
                    <div class="card-info"><h3>PERSONEL KAYDI</h3><p>ŞOFÖR & EVRAK</p></div>
                </div>

                <div class="cyber-card" onclick="openModal('sunucu-modal')" data-aos="fade-up" data-aos-delay="600">
                    <i class="fas fa-server" style="color: #fff;"></i>
                    <div class="card-info"><h3>ANA SUNUCU</h3><p>SİSTEM DURUMU</p></div>
                </div>
            </section>
        </div>

        <footer class="admin-footer">
            <div style="margin-bottom:5px;">EGE KALYON LOJİSTİK SİSTEMLERİ <span style="color:var(--cyber-cyan)">V4.0</span></div>
            <div style="opacity:0.4;">DESIGNED BY BATU YAZILIM // 2026</div>
        </footer>
    </main>

    <div id="note-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// HAFIZA NOTLARI</h2><span onclick="closeModal('note-modal')">✕</span></div>
            <div style="display:flex; gap:20px; margin-bottom:30px;">
                <input type="text" id="note-input" placeholder=">> VERİ GİRİŞİ YAPIN..." class="cyber-input">
                <button id="note-save-btn" onclick="addNote()" class="cyber-btn">KAYDET</button>
            </div>
            <ul id="note-list" style="list-style:none;"></ul>
        </div>
    </div>

    <div id="driver-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// ŞOFÖR YÖNETİM PANELİ</h2><span onclick="closeModal('driver-modal')">✕</span></div>
            
            <div style="background:rgba(255,255,255,0.02); padding:30px; border-left:3px solid var(--cyber-cyan); margin-bottom:30px;">
                <h4 style="color:var(--cyber-cyan); font-family:'Orbitron'; margin-bottom:20px;">YENİ PERSONEL GİRİŞİ</h4>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                    <input type="text" id="d-name" placeholder="AD SOYAD" class="cyber-input">
                    <input type="text" id="d-tc" placeholder="TC KİMLİK" class="cyber-input" maxlength="11">
                    <input type="text" id="d-phone" placeholder="TELEFON" class="cyber-input">
                    <input type="text" id="d-plate" placeholder="ARAÇ PLAKA" class="cyber-input">
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.7rem; color: #666; font-family:'Orbitron'; margin-bottom: 5px;">EHLİYET S.K.T</span>
                        <input type="date" id="d-lic-date" class="cyber-input" style="color-scheme: dark;">
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.7rem; color: #666; font-family:'Orbitron'; margin-bottom: 5px;">SRC S.K.T</span>
                        <input type="date" id="d-src-date" class="cyber-input" style="color-scheme: dark;">
                    </div>
                </div>
                <button onclick="addDriver()" class="cyber-btn" style="width:100%">VERİTABANINA İŞLE</button>
            </div>

            <div style="overflow-x: auto;">
                <table class="driver-table">
                    <thead>
                        <tr>
                            <th>KİMLİK</th>
                            <th>İLETİŞİM / TC</th>
                            <th>ARAÇ ID</th>
                            <th>EHLİYET DURUM</th>
                            <th>SRC DURUM</th>
                            <th style="text-align: right;">KOMUT</th>
                        </tr>
                    </thead>
                    <tbody id="driver-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="sheets-overlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:#000; z-index:4000; display:none; flex-direction:column;">
        <div style="background:#050505; padding:20px; display:flex; justify-content:space-between; border-bottom:2px solid var(--cyber-cyan);">
            <h2 style="color:var(--cyber-cyan); font-family:'Orbitron'">HARİCİ VERİ BAĞLANTISI</h2>
            <button onclick="closeSheets()" class="cyber-btn" style="border-color:var(--cyber-red); color:var(--cyber-red);">BAĞLANTIYI KES</button>
        </div>
        <iframe id="sheets-iframe" src="" style="width:100%; height:100%; border:none;"></iframe>
    </div>

    <div id="sunucu-modal" class="modal">
        <div class="modal-content" style="text-align:center; max-width:500px;">
            <div class="modal-header"><h2>SİSTEM DURUMU</h2><span onclick="closeModal('sunucu-modal')">✕</span></div>
            <div style="font-size:1.5rem; color:var(--cyber-cyan); margin-bottom:10px; font-family:'Orbitron'">SYSTEM: OPTIMAL</div>
            <div style="font-size:1rem; color:#666; font-family:'Rajdhani'">DATA FLOW: STABLE (45ms)</div>
            <div style="margin-top:30px; font-size:4rem; color:var(--cyber-cyan); animation: pulse 2s infinite;"><i class="fas fa-fingerprint"></i></div>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();
        
        // Dijital Saat
        setInterval(() => {
            const now = new Date();
            document.getElementById('digital-clock').innerText = now.toLocaleTimeString('tr-TR');
            document.getElementById('digital-date').innerText = now.toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' }).toUpperCase();
        }, 1000);

        // Modal İşlemleri
        function openModal(id) { document.getElementById(id).style.display = 'block'; if(id==='driver-modal') renderDrivers(); if(id==='note-modal') renderNotes(); }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        // Google Sheets
        function openSheets(type) {
            const overlay = document.getElementById('sheets-overlay');
            const iframe = document.getElementById('sheets-iframe');
            if(type==='cizelge') iframe.src = "https://docs.google.com/spreadsheets/d/1WaSNv0a2Nn-xDiHMX3VsLwYaOwTS5maCtrzRS9zUdlc/edit?rm=minimal";
            else iframe.src = "https://docs.google.com/spreadsheets/d/1sCy68YJYkvFIpQumgP6_tt5mcBFgDm2WLIbvuVHCgIM/edit?rm=minimal";
            overlay.style.display = 'flex';
        }
        function closeSheets() { document.getElementById('sheets-overlay').style.display = 'none'; document.getElementById('sheets-iframe').src = ""; }

        /* NOT SİSTEMİ */
        let editNoteId = null;
        function getNotes() { return JSON.parse(localStorage.getItem('terminal_notes_v3') || '[]'); }
        function saveNotes(notes) { localStorage.setItem('terminal_notes_v3', JSON.stringify(notes)); }
        function addNote() {
            const input = document.getElementById('note-input');
            if(!input.value) return;
            const notes = getNotes();
            const now = new Date();
            const dateStr = now.toLocaleDateString('tr-TR') + " " + now.toLocaleTimeString('tr-TR', {hour: '2-digit', minute:'2-digit'});
            if(editNoteId) {
                const updatedNotes = notes.map(n => n.id === editNoteId ? {...n, text: input.value, date: dateStr} : n);
                saveNotes(updatedNotes); editNoteId = null;
                document.getElementById('note-save-btn').innerText = "KAYDET";
            } else {
                notes.push({ id: Date.now(), text: input.value, date: dateStr, done: false });
                saveNotes(notes);
            }
            input.value = ""; renderNotes();
        }
        function startEdit(id, text) {
            document.getElementById('note-input').value = text;
            editNoteId = id; document.getElementById('note-save-btn').innerText = "GÜNCELLE";
            document.getElementById('note-input').focus();
        }
        function deleteNote(id) { saveNotes(getNotes().filter(n => n.id !== id)); renderNotes(); }
        function toggleNote(id) { saveNotes(getNotes().map(n => n.id === id ? {...n, done: !n.done} : n)); renderNotes(); }
        
        function renderNotes() {
            document.getElementById('note-list').innerHTML = getNotes().map(n => `
                <li style="background:rgba(255,255,255,0.02); padding:15px; margin-bottom:10px; border-left:4px solid ${n.done ? 'var(--cyber-cyan)' : 'var(--cyber-red)'}; display:flex; justify-content:space-between; align-items:center;">
                    <span style="${n.done ? 'text-decoration:line-through; opacity:0.5' : ''}; font-family:'Rajdhani'; font-size:1.1rem; font-weight:600;">${n.text} <small style="display:block; color:#555; font-size:0.7em; font-family:'Orbitron'">${n.date}</small></span>
                    <div style="display:flex; gap:15px;">
                        <button onclick="toggleNote(${n.id})" style="background:none; border:none; color:var(--cyber-cyan); cursor:pointer; font-size:1.2rem;"><i class="fas fa-check"></i></button>
                        <button onclick="startEdit(${n.id}, '${n.text.replace(/'/g, "\\'")}')" style="background:none; border:none; color:#fff; cursor:pointer; font-size:1.2rem;"><i class="fas fa-edit"></i></button>
                        <button onclick="deleteNote(${n.id})" style="background:none; border:none; color:var(--cyber-red); cursor:pointer; font-size:1.2rem;"><i class="fas fa-trash"></i></button>
                    </div>
                </li>`).join('');
        }

        /* ŞOFÖR SİSTEMİ */
        function getDrivers() { return JSON.parse(localStorage.getItem('drivers_v4') || '[]'); }
        function addDriver() {
            const name = document.getElementById('d-name').value;
            const tc = document.getElementById('d-tc').value;
            const phone = document.getElementById('d-phone').value;
            const plate = document.getElementById('d-plate').value;
            const licDate = document.getElementById('d-lic-date').value;
            const srcDate = document.getElementById('d-src-date').value;
            if(!name) { alert("ERROR: İSİM GİRİŞİ ZORUNLU."); return; }
            const drivers = getDrivers();
            drivers.push({ id: Date.now(), name, tc, phone, plate, licDate, srcDate });
            localStorage.setItem('drivers_v4', JSON.stringify(drivers));
            document.getElementById('d-name').value = ""; document.getElementById('d-tc').value = "";
            document.getElementById('d-phone').value = ""; document.getElementById('d-plate').value = "";
            document.getElementById('d-lic-date').value = ""; document.getElementById('d-src-date').value = "";
            renderDrivers();
        }
        function deleteDriver(id) {
            if(confirm('PERSONEL KAYDI SİLİNECEK. ONAYLIYOR MUSUNUZ?')) {
                localStorage.setItem('drivers_v4', JSON.stringify(getDrivers().filter(d => d.id !== id)));
                renderDrivers();
            }
        }
        function isExpired(dateString) {
            if (!dateString) return false;
            const today = new Date(); today.setHours(0,0,0,0);
            return new Date(dateString) < today;
        }
        function formatDate(dateString) {
            if (!dateString) return "-";
            return new Date(dateString).toLocaleDateString('tr-TR');
        }
        function renderDrivers() {
            const tbody = document.getElementById('driver-tbody');
            const drivers = getDrivers();
            if (drivers.length === 0) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:30px; color:#444; font-family:\'Orbitron\'">// VERİTABANI BOŞ //</td></tr>'; return; }
            tbody.innerHTML = drivers.map(d => {
                const licExpired = isExpired(d.licDate);
                const srcExpired = isExpired(d.srcDate);
                let licHtml = `<span style="color:var(--cyber-cyan)">${formatDate(d.licDate)}</span>`;
                if(licExpired) licHtml = `<span class="expired-warning">⚠ SÜRE DOLDU (${formatDate(d.licDate)})</span>`;
                let srcHtml = `<span style="color:var(--cyber-cyan)">${formatDate(d.srcDate)}</span>`;
                if(srcExpired) srcHtml = `<span class="expired-warning">⚠ SÜRE DOLDU (${formatDate(d.srcDate)})</span>`;
                return `
                <tr>
                    <td><b style="color:#fff; font-size:1.1rem;">${d.name}</b></td>
                    <td><div style="font-size:0.9rem; color:#888;">TC: ${d.tc || '-'}</div><div style="font-size:0.9rem; color:var(--cyber-cyan);">${d.phone || '-'}</div></td>
                    <td><span style="border:1px solid #555; padding:4px 8px; color:#fff; font-family:'Orbitron'">${d.plate || '-'}</span></td>
                    <td>${licHtml}</td>
                    <td>${srcHtml}</td>
                    <td style="text-align:right"><button onclick="deleteDriver(${d.id})" style="color:var(--cyber-red); background:none; border:none; cursor:pointer; font-size:1.2rem;"><i class="fas fa-trash"></i></button></td>
                </tr>`;
            }).join('');
        }
    </script>
</body>
</html>


