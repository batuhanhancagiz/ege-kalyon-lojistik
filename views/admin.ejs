<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@300;500;600;700&display=swap" rel="stylesheet">
    <title>Ege Kalyon | Terminal V1.4 MOBILE</title>
    <style>
        :root { 
            --neon-blue: #00f3ff;
            --neon-purple: #bc13fe;
            --neon-pink: #ff0055;
            --neon-yellow: #fcee0a;
            --neon-green: #0aff0a;
            --bg-dark: #050505;
            --glass-bg: rgba(10, 15, 25, 0.75);
            --glass-border: rgba(0, 243, 255, 0.2);
            --text-main: #e0e0e0;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Rajdhani', sans-serif;
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
            font-size: 16px;
        }

        /* --- LOADING SCREEN (AÇILIŞ EKRANI) --- */
        #boot-screen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #000; z-index: 9999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 1s ease-out;
        }
        .loader-text { color: var(--neon-blue); font-family: 'Orbitron'; letter-spacing: 5px; animation: blink 0.2s infinite; margin-bottom: 20px; }
        .loader-bar { width: 300px; height: 4px; background: #333; position: relative; overflow: hidden; }
        .loader-bar::after {
            content: ''; position: absolute; top: 0; left: 0; width: 0%; height: 100%; background: var(--neon-blue);
            animation: loadProgress 2s ease-in-out forwards;
        }
        @keyframes loadProgress { 0% { width: 0%; } 100% { width: 100%; } }

        /* --- BACKGROUND FX --- */
        .cyber-grid-floor {
            position: fixed; bottom: -30%; left: -50%; width: 200%; height: 100%;
            background-image: 
                linear-gradient(var(--neon-purple) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 243, 255, 0.3) 1px, transparent 1px);
            background-size: 50px 50px;
            transform: perspective(300px) rotateX(60deg);
            opacity: 0.15;
            animation: moveGrid 10s linear infinite;
            z-index: -2;
            pointer-events: none;
        }
        @keyframes moveGrid { 0% { background-position: 0 0; } 100% { background-position: 0 50px; } }

        .scanlines {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(0deg, rgba(0,0,0,0.15), rgba(0,0,0,0.15) 1px, transparent 1px, transparent 2px);
            pointer-events: none; z-index: 9998; opacity: 0.4;
        }

        /* --- MOBILE MENU TOGGLE --- */
        .menu-toggle {
            display: none; position: fixed; top: 20px; left: 20px; z-index: 2000;
            background: rgba(0,0,0,0.8); border: 1px solid var(--neon-blue);
            color: var(--neon-blue); padding: 10px 15px; border-radius: 5px;
            cursor: pointer; font-size: 1.2rem;
        }

        /* --- SIDEBAR --- */
        .sidebar { 
            width: 280px; height: 100vh; position: fixed; left: 0; top: 0; 
            background: rgba(5, 5, 8, 0.95);
            backdrop-filter: blur(20px);
            border-right: 1px solid var(--glass-border); 
            padding: 40px 20px; z-index: 1000; 
            box-shadow: 10px 0 50px rgba(0,0,0,0.8);
            transition: transform 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
        }
        
        .sidebar-title {
            font-family: 'Orbitron', sans-serif; font-size: 1.8rem; font-weight: 900;
            color: #fff; text-align: center; margin-bottom: 40px;
            text-shadow: 0 0 10px var(--neon-blue);
            border-bottom: 2px solid var(--neon-purple); padding-bottom: 20px;
        }
        .sidebar-title span { display: block; font-size: 0.5em; color: var(--neon-green); letter-spacing: 3px; margin-top: 5px; }

        .nav-item {
            display: flex; align-items: center; gap: 15px; 
            color: #aaa; text-decoration: none; padding: 16px 20px; 
            margin-bottom: 10px; border-radius: 0 20px 20px 0;
            font-family: 'Orbitron', sans-serif; font-size: 0.85rem; letter-spacing: 1px;
            border-left: 2px solid transparent;
            transition: 0.3s;
            position: relative; overflow: hidden;
        }
        .nav-item::before {
            content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 243, 255, 0.1), transparent);
            transition: 0.5s;
        }
        .nav-item:hover, .nav-item.active {
            color: #fff; border-left: 3px solid var(--neon-blue);
            background: rgba(0, 243, 255, 0.05); text-shadow: 0 0 8px var(--neon-blue);
        }
        .nav-item:hover::before { left: 100%; }
        
        /* --- MAIN CONTENT --- */
        .admin-main { flex: 1; margin-left: 280px; min-height: 100vh; display: flex; flex-direction: column; width: calc(100% - 280px); position: relative; z-index: 1; transition: 0.3s; }
        .content-wrapper { padding: 40px; flex: 1; }

        /* HEADER */
        .admin-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
        .glitch-wrapper h1 { font-family: 'Orbitron'; font-size: 2.5rem; color: #fff; text-shadow: 2px 2px var(--neon-pink), -2px -2px var(--neon-blue); }
        .status-bar { display: flex; gap: 15px; margin-top: 10px; }
        .status-item { font-size: 0.75rem; color: var(--neon-blue); border: 1px solid var(--neon-blue); padding: 2px 8px; border-radius: 4px; }
        
        #digital-clock { font-family: 'Orbitron'; font-size: 2.5rem; color: #fff; text-shadow: 0 0 15px rgba(255,255,255,0.5); line-height: 1; }
        #digital-date { color: var(--neon-purple); font-family: 'Rajdhani'; font-weight: 700; text-align: right; letter-spacing: 2px; }

        /* CARDS GRID */
        .grid-cockpit-v2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 30px; }
        
        .cyber-card { 
            background: var(--glass-bg); border: 1px solid rgba(255,255,255,0.1);
            padding: 25px; border-radius: 12px; position: relative; overflow: hidden;
            transition: 0.3s; cursor: pointer; backdrop-filter: blur(10px);
            display: flex; flex-direction: column; justify-content: space-between;
            min-height: 160px;
        }
        .cyber-card:hover { transform: translateY(-5px); border-color: var(--neon-blue); box-shadow: 0 0 25px rgba(0, 243, 255, 0.15); }
        .cyber-card i { font-size: 2.5rem; margin-bottom: 15px; color: #ccc; transition: 0.3s; }
        .cyber-card:hover i { color: #fff; transform: scale(1.1); filter: drop-shadow(0 0 5px currentColor); }
        
        /* Animated Progress Bar inside Card */
        .mini-progress { width: 100%; height: 4px; background: #333; margin-top: 10px; border-radius: 2px; position: relative; overflow: hidden; }
        .mini-progress-bar { height: 100%; background: var(--neon-green); width: 75%; animation: progressAnim 2s ease-out; }
        @keyframes progressAnim { from { width: 0; } }

        /* MODALS */
        .modal { display: none; position: fixed; z-index: 3000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); backdrop-filter: blur(10px); }
        .modal-content { 
            background: rgba(10, 15, 20, 0.95); margin: 5% auto; padding: 30px; 
            border: 1px solid var(--neon-blue); border-top: 4px solid var(--neon-blue);
            width: 90%; max-width: 800px; max-height: 90vh; overflow-y: auto;
            box-shadow: 0 0 50px rgba(0, 243, 255, 0.1); 
        }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; }
        
        /* INPUTS & BUTTONS */
        .cyber-input { background: rgba(255,255,255,0.05); border: 1px solid #333; color: #fff; padding: 12px; width: 100%; outline: none; font-family: 'Rajdhani'; letter-spacing: 1px; transition:0.3s; border-radius: 6px; }
        .cyber-input:focus { border-color: var(--neon-blue); background: rgba(0,0,0,0.8); }
        .cyber-btn { background: rgba(0, 243, 255, 0.1); border: 1px solid var(--neon-blue); color: var(--neon-blue); padding: 12px 25px; font-family: 'Orbitron'; cursor: pointer; transition: 0.3s; width: 100%; font-weight: bold; border-radius: 6px; }
        .cyber-btn:hover { background: var(--neon-blue); color: #000; box-shadow: 0 0 20px var(--neon-blue); }

        /* TABLES */
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .driver-table { width:100%; border-collapse: collapse; min-width: 600px; }
        .driver-table th { text-align: left; padding: 15px; color: var(--neon-purple); border-bottom: 1px solid #333; font-family: 'Orbitron'; font-size: 0.8rem; }
        .driver-table td { padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); color: #ccc; }
        .expired-warning { color: var(--neon-pink); font-weight: bold; animation: blink 1s infinite; }

        /* FOOTER */
        .admin-footer { padding: 20px; text-align: center; color: #555; font-size: 0.7rem; border-top: 1px solid #222; margin-top: auto; }

        /* --- RESPONSIVE CSS (MOBILE) --- */
        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            .sidebar { transform: translateX(-100%); width: 280px; }
            .sidebar.active { transform: translateX(0); }
            
            .admin-main { margin-left: 0; width: 100%; }
            .content-wrapper { padding: 20px; padding-top: 70px; }
            
            .admin-header { flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 30px; }
            .glitch-wrapper h1 { font-size: 1.8rem; }
            #digital-clock { font-size: 2rem; margin-top: 10px; }
            #digital-date { text-align: left; }

            .grid-cockpit-v2 { grid-template-columns: 1fr; gap: 15px; }
            .modal-content { margin: 15% auto; width: 95%; padding: 20px; }
            
            .input-group-grid { display: grid; grid-template-columns: 1fr !important; gap: 10px !important; }
        }
    </style>
</head>
<body>

    <div id="boot-screen">
        <div class="loader-text">SİSTEM BAŞLATILIYOR...</div>
        <div class="loader-bar"></div>
        <div style="margin-top:10px; color:#555; font-size:0.8rem; font-family:'Rajdhani'">EGE KALYON V1.4 PROTOCOL</div>
    </div>

    <div class="scanlines"></div>
    <div class="cyber-grid-floor"></div>
    
    <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>

    <aside class="sidebar" id="mySidebar">
        <div class="sidebar-title">
            EGE KALYON
            <span>OS SYSTEM V1.4</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="nav-item active"><i class="fas fa-microchip"></i> <span>KOKPİT</span></a>
            <a href="#" onclick="openSheets('cizelge')" class="nav-item"><i class="fas fa-file-waveform"></i> <span>VERİ AKIŞI</span></a>
            <a href="#" onclick="openSheets('bekleme')" class="nav-item"><i class="fas fa-hourglass-start"></i> <span>HAKEDİŞ</span></a>
