                    <div><div class="card-title">YAKIT & FİYAT</div><div class="card-desc">P.O CANLI FİYATLAR</div></div>
                </div>

                <a href="https://web.arvento.com/" target="_blank" class="cyber-card" style="text-decoration:none;" data-aos="zoom-in" data-aos-delay="400">
                    <i class="fas fa-satellite card-icon" style="color: var(--neon-green);"></i>
                    <div><div class="card-title">ARVENTO SAT</div><div class="card-desc">UYDU BAĞLANTISI</div></div>
                </a>

                <div class="cyber-card" onclick="openModal('driver-modal')" data-aos="zoom-in" data-aos-delay="500">
