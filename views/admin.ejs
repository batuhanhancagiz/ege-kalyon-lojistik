            </div>

            <div class="cards-grid">
                <div class="cyber-card" onclick="openSheets('cizelge')" data-aos="zoom-in" data-aos-delay="100">
                    <i class="fas fa-table-cells card-icon" style="color: #4285F4;"></i>
                    <div><div class="card-title">DİJİTAL ÇİZELGE</div><div class="card-desc">VERİ TABLOSU</div></div>
                </div>

                <div class="cyber-card" onclick="openSheets('bekleme')" data-aos="zoom-in" data-aos-delay="200">
