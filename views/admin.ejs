    </main>

    <div id="driver-modal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closeModal('driver-modal')">✕</span>
            <div class="modal-header"><h2>// PERSONEL YÖNETİMİ</h2></div>
            
            <div style="background:rgba(255,255,255,0.03); padding:20px; border-radius:10px; margin-bottom:20px;">
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:15px;">
                    <input type="text" id="d-name" placeholder="AD SOYAD" class="cyber-input">
                    <input type="text" id="d-tc" placeholder="TC KİMLİK" class="cyber-input" maxlength="11">
                    <input type="text" id="d-phone" placeholder="TELEFON" class="cyber-input">
                    <input type="text" id="d-plate" placeholder="ARAÇ PLAKA" class="cyber-input">
                    <div>
                        <label style="font-size:0.7rem; color:#888;">EHLİYET S.K.T</label>
                        <input type="date" id="d-lic-date" class="cyber-input">
                    </div>
                    <div>
                        <label style="font-size:0.7rem; color:#888;">SRC S.K.T</label>
                        <input type="date" id="d-src-date" class="cyber-input">
                    </div>
                </div>
                <button onclick="addDriver()" class="cyber-btn">KAYDET VE SİSTEME İŞLE</button>
            </div>

            <div style="overflow-x:auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>KİMLİK</th><th>İLETİŞİM</th><th>ARAÇ</th><th>EHLİYET</th><th>SRC</th><th>İŞLEM</th>
                        </tr>
                    </thead>
                    <tbody id="driver-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="fuel-modal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closeModal('fuel-modal')">✕</span>
            <div class="modal-header"><h2>// YAKIT YÖNETİM & PİYASA</h2></div>

            <div style="border:1px solid var(--neon-pink); padding:20px; border-radius:10px; background:rgba(255,0,80,0.05); margin-bottom:20px;">
                <h3 style="color:var(--neon-pink); font-family:'Orbitron'; margin-bottom:15px;">PETROL OFİSİ GÜNCEL FİYATLAR (İZMİR)</h3>
                <button onclick="fetchFuelData()" class="cyber-btn" style="border-color:var(--neon-pink); color:var(--neon-pink); margin-bottom:15px;">
                    <i class="fas fa-sync"></i> FİYATLARI GÜNCELLE
                </button>
                <div id="fuel-loader" style="display:none; color:var(--neon-blue); margin-bottom:10px;">
                    <i class="fas fa-circle-notch fa-spin"></i> PETROL OFİSİ SUNUCUSUNA BAĞLANILIYOR...
                </div>
                <table class="data-table" id="fuel-table">
                    <tr><td colspan="3" style="text-align:center; color:#666;">VERİ BEKLENİYOR...</td></tr>
                </table>
                <p style="font-size:0.7rem; color:#666; margin-top:5px; text-align:right;">* VERİLER SİMÜLASYON AMAÇLIDIR VE ANLIK DEĞİŞEBİLİR.</p>
            </div>

            <div style="background:rgba(255,255,255,0.03); padding:20px; border-radius:10px;">
                <h4 style="color:#fff; font-family:'Orbitron'; margin-bottom:15px;">MALİYET HESAPLAYICI</h4>
                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <input type="number" id="calc-km" placeholder="YOL (KM)" class="cyber-input" style="flex:1;">
                    <input type="number" id="calc-cons" placeholder="TÜKETİM (L/100KM)" class="cyber-input" value="30" style="flex:1;">
                    <button onclick="calculateFuelCost()" class="cyber-btn" style="flex:1; border-color:var(--neon-yellow); color:var(--neon-yellow)">HESAPLA</button>
                </div>
                <div id="calc-result" style="margin-top:15px; font-size:1.2rem; color:var(--neon-green); font-weight:bold; text-align:center;"></div>
            </div>
        </div>
    </div>

    <div id="maintenance-modal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closeModal('maintenance-modal')">✕</span>
            <div class="modal-header"><h2>// BAKIM & ONARIM TAKİBİ</h2></div>
            <table class="data-table">
                <tr><th>ARAÇ</th><th>İŞLEM</th><th>DURUM</th><th>TARİH</th></tr>
                <tr><td>34 KLN 99</td><td>PERİYODİK BAKIM</td><td style="color:var(--neon-orange)">SERVİSTE</td><td>BUGÜN</td></tr>
                <tr><td>35 EGE 35</td><td>LASTİK DEĞİŞİMİ</td><td style="color:var(--neon-red)">BEKLİYOR</td><td>YARIN</td></tr>
                <tr><td>34 AAB 12</td><td>YAĞ DEĞİŞİMİ</td><td style="color:var(--neon-green)">TAMAMLANDI</td><td>DÜN</td></tr>
            </table>
            <button class="cyber-btn" style="margin-top:20px; border-color:var(--neon-orange); color:var(--neon-orange)">YENİ BAKIM KAYDI OLUŞTUR</button>
        </div>
    </div>

    <div id="map-modal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closeModal('map-modal')">✕</span>
            <div class="modal-header"><h2>// FİLO CANLI HARİTA</h2></div>
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d200000!2d27.1!3d38.4!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14bbd862a762cacd%3A0x628cbba1a59ce8fe!2s%C4%B0zmir!5e0!3m2!1str!2str!4v1600000000000!5m2!1str!2str" width="100%" height="450" style="border:0; border-radius:10px; filter: invert(90%) hue-rotate(180deg);" allowfullscreen="" loading="lazy"></iframe>
        </div>
    </div>

    <div id="finance-modal" class="modal">
        <div class="modal-content" style="text-align:center;">
            <span class="modal-close" onclick="closeModal('finance-modal')">✕</span>
            <div class="modal-header"><h2>// FİNANSAL RAPOR</h2></div>
            <h1 style="font-size:3.5rem; color:var(--neon-green); text-shadow:0 0 20px var(--neon-green); margin:30px 0;">₺ 854,250.00</h1>
            <p style="color:#aaa;">OCAK 2026 - TOPLAM HAKEDİŞ</p>
            <div style="display:flex; justify-content:space-around; margin-top:30px;">
                <div>
                    <div style="color:var(--neon-blue); font-size:1.5rem;">₺ 120,000</div>
                    <div style="font-size:0.8rem; color:#666;">YAKIT GİDERİ</div>
                </div>
                <div>
                    <div style="color:var(--neon-purple); font-size:1.5rem;">₺ 45,000</div>
                    <div style="font-size:0.8rem; color:#666;">BAKIM GİDERİ</div>
                </div>
            </div>
        </div>
    </div>

    <div id="note-modal" class="modal">
        <div class="modal-content">
            <span class="modal-close" onclick="closeModal('note-modal')">✕</span>
            <div class="modal-header"><h2>// HAFIZA NOTLARI</h2></div>
            <div style="display:flex; gap:10px; margin-bottom:20px;">
                <input type="text" id="note-input" placeholder=">> SİSTEME NOT EKLE..." class="cyber-input">
                <button onclick="addNote()" class="cyber-btn" style="width:auto;">KAYDET</button>
            </div>
            <ul id="note-list" style="list-style:none; padding:0;"></ul>
        </div>
    </div>

    <div id="sheets-overlay">
        <div class="overlay-bar">
            <h3 style="color:var(--neon-blue); font-family:'Orbitron'; margin:0;">VERİ BAĞLANTISI</h3>
            <button onclick="closeSheets()" style="background:none; border:none; color:var(--neon-pink); font-size:1.5rem; cursor:pointer;"><i class="fas fa-times"></i></button>
        </div>
        <iframe id="sheets-iframe" src="" style="width:100%; height:100%; border:none;"></iframe>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();

        // --- SİSTEM BAŞLANGIÇ (BOOT) ---
        window.addEventListener('load', () => {
            const cmdLines = [
                "KERNEL_INIT...",
                "LOADING_MODULES: [GPS, DB, SECURE_SHELL]...",
                "CONNECTING TO SATELLITE LINK...",
                "SYNCING WITH PETROL OFISI API (SIM)...",
                "FLEET STATUS: ACTIVE",
                "SYSTEM READY."
            ];
            const bootCmd = document.getElementById('boot-cmd');
            let i = 0;
            
            const interval = setInterval(() => {
                if(i < cmdLines.length) {
                    const div = document.createElement('div');
                    div.innerText = "> " + cmdLines[i];
                    bootCmd.appendChild(div);
                    i++;
                } else {
                    clearInterval(interval);
                    setTimeout(() => {
                        document.getElementById('boot-screen').style.opacity = '0';
                        setTimeout(() => { document.getElementById('boot-screen').style.display = 'none'; }, 800);
                        initWeather(); // Hava durumu başlat
                    }, 500);
                }
            }, 300);
        });

        // --- SAAT & TARİH ---
        setInterval(() => {
            const now = new Date();
            document.getElementById('digital-clock').innerText = now.toLocaleTimeString('tr-TR');
            document.getElementById('digital-date').innerText = now.toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' }).toUpperCase();
        }, 1000);

        // --- MOBİL MENÜ ---
        function toggleSidebar() { document.getElementById('mySidebar').classList.toggle('active'); }

        // --- MODAL YÖNETİMİ ---
        function openModal(id) {
            document.getElementById(id).style.display = 'block';
            if(id === 'driver-modal') renderDrivers();
            if(id === 'note-modal') renderNotes();
            // Mobilde menüyü kapat
            document.getElementById('mySidebar').classList.remove('active');
        }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        // --- SHEETS YÖNETİMİ ---
        function openSheets(type) {
            const overlay = document.getElementById('sheets-overlay');
            const iframe = document.getElementById('sheets-iframe');
            if(type === 'cizelge') iframe.src = "https://docs.google.com/spreadsheets/d/1WaSNv0a2Nn-xDiHMX3VsLwYaOwTS5maCtrzRS9zUdlc/edit?rm=minimal";
            else iframe.src = "https://docs.google.com/spreadsheets/d/1sCy68YJYkvFIpQumgP6_tt5mcBFgDm2WLIbvuVHCgIM/edit?rm=minimal";
            overlay.style.display = 'flex';
        }
        function closeSheets() { document.getElementById('sheets-overlay').style.display = 'none'; document.getElementById('sheets-iframe').src = ""; }

        // --- LOG SİMÜLASYONU (Matrix) ---
        const logMessages = ["DATA_PACKET_RCVD", "PING: 12ms", "GPS_SYNC: OK", "ENCRYPTION_KEY_ROTATED", "DRIVER_STATUS_UPDATE", "FUEL_CHECK_COMPLETE"];
        function addLog() {
            const container = document.getElementById('log-container');
            const entry = document.createElement('div');
            entry.className = 'log-entry';
            entry.innerHTML = `> ${logMessages[Math.floor(Math.random()*logMessages.length)]} <span style="float:right; opacity:0.5">${new Date().toLocaleTimeString()}</span>`;
            container.prepend(entry);
            if(container.children.length > 8) container.removeChild(container.lastChild);
        }
        setInterval(addLog, 2500);

        // --- HAVA DURUMU (İZMİR SİMÜLASYON) ---
        function initWeather() {
            const badge = document.getElementById('weather-badge');
            // Rastgele hava durumu
            const temps = [16, 17, 18, 19];
            const conds = ["AÇIK", "PARÇALI BULUTLU", "RÜZGARLI"];
            const t = temps[Math.floor(Math.random()*temps.length)];
            const c = conds[Math.floor(Math.random()*conds.length)];
            badge.innerHTML = `<i class="fas fa-cloud-sun"></i> İZMİR: ${t}°C ${c}`;
        }

        // --- PETROL OFİSİ VERİ ÇEKME SİMÜLASYONU & HESAPLAMA ---
        let currentDieselPrice = 0;

        function fetchFuelData() {
            const loader = document.getElementById('fuel-loader');
            const table = document.getElementById('fuel-table');
            
            loader.style.display = 'block';
            table.innerHTML = '<tr><td colspan="3" style="text-align:center;">VERİ BEKLENİYOR...</td></tr>';

            // 1.5 Saniye gecikme ile "Web Scraping" taklidi yap
            setTimeout(() => {
                loader.style.display = 'none';
                
                // Gerçekçi 2026/Güncel Tahmini Fiyatlar
                const prices = {
                    diesel: (45.30 + Math.random()).toFixed(2),
                    gas: (44.15 + Math.random()).toFixed(2),
                    lpg: (24.90 + Math.random()).toFixed(2)
                };
                currentDieselPrice = parseFloat(prices.diesel); // Hesaplama için kaydet

                table.innerHTML = `
                    <tr><th>ÜRÜN</th><th>FİYAT</th><th>DURUM</th></tr>
                    <tr><td>V/MAX MOTORİN</td><td style="color:#fff; font-weight:bold;">${prices.diesel} TL</td><td style="color:var(--neon-green)">%0.1 <i class="fas fa-caret-up"></i></td></tr>
                    <tr><td>V/MAX KURŞUNSUZ 95</td><td style="color:#fff; font-weight:bold;">${prices.gas} TL</td><td style="color:var(--neon-green)">%0.05 <i class="fas fa-caret-up"></i></td></tr>
                    <tr><td>PO/GAZ</td><td style="color:#fff; font-weight:bold;">${prices.lpg} TL</td><td style="color:var(--neon-pink)">SABİT <i class="fas fa-minus"></i></td></tr>
                `;
            }, 1500);
        }

        function calculateFuelCost() {
            const km = parseFloat(document.getElementById('calc-km').value);
            const cons = parseFloat(document.getElementById('calc-cons').value);
            
            if(!km || !cons) { alert("Lütfen KM ve Tüketim değerlerini girin."); return; }
            if(currentDieselPrice === 0) { alert("Lütfen önce güncel fiyatları çekin!"); return; }

            const totalLiters = (km * cons) / 100;
            const totalCost = totalLiters * currentDieselPrice;
            
            document.getElementById('calc-result').innerHTML = `TAHMİNİ TUTAR: ${totalCost.toFixed(2)} TL`;
        }

        // --- ŞOFÖR YÖNETİMİ ---
        function getDrivers() { return JSON.parse(localStorage.getItem('drivers_v5') || '[]'); }
        function addDriver() {
            const name = document.getElementById('d-name').value;
            if(!name) { alert("İsim zorunlu!"); return; }
            
            const drivers = getDrivers();
            drivers.push({
                id: Date.now(),
                name: name,
                tc: document.getElementById('d-tc').value,
                phone: document.getElementById('d-phone').value,
                plate: document.getElementById('d-plate').value,
                licDate: document.getElementById('d-lic-date').value,
                srcDate: document.getElementById('d-src-date').value
            });
            localStorage.setItem('drivers_v5', JSON.stringify(drivers));
            renderDrivers();
            document.querySelectorAll('#driver-modal input').forEach(i => i.value = '');
        }
        function deleteDriver(id) {
            if(confirm('Silmek istiyor musunuz?')) {
                localStorage.setItem('drivers_v5', JSON.stringify(getDrivers().filter(d => d.id !== id)));
                renderDrivers();
            }
        }
        function renderDrivers() {
            const tbody = document.getElementById('driver-tbody');
            const drivers = getDrivers();
            if(drivers.length === 0) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">KAYIT YOK</td></tr>'; return; }
            
            tbody.innerHTML = drivers.map(d => {
                const now = new Date();
                const licExp = d.licDate ? new Date(d.licDate) < now : false;
                const srcExp = d.srcDate ? new Date(d.srcDate) < now : false;
                
                return `<tr>
                    <td style="color:#fff; font-weight:bold;">${d.name}</td>
                    <td>${d.phone}</td>
                    <td><span style="background:#222; padding:2px 6px; border-radius:4px;">${d.plate}</span></td>
                    <td style="color:${licExp ? 'var(--neon-pink)' : 'var(--neon-green)'}">${d.licDate || '-'}</td>
                    <td style="color:${srcExp ? 'var(--neon-pink)' : 'var(--neon-green)'}">${d.srcDate || '-'}</td>
                    <td><button onclick="deleteDriver(${d.id})" style="color:var(--neon-pink); background:none; border:none; cursor:pointer;"><i class="fas fa-trash"></i></button></td>
                </tr>`;
            }).join('');
        }

        // --- NOT SİSTEMİ ---
        function getNotes() { return JSON.parse(localStorage.getItem('notes_v3') || '[]'); }
        function addNote() {
            const input = document.getElementById('note-input');
            if(!input.value) return;
            const notes = getNotes();
            notes.push({ id: Date.now(), text: input.value, date: new Date().toLocaleString('tr-TR') });
            localStorage.setItem('notes_v3', JSON.stringify(notes));
            input.value = ''; renderNotes();
        }
        function deleteNote(id) {
            localStorage.setItem('notes_v3', JSON.stringify(getNotes().filter(n => n.id !== id)));
            renderNotes();
        }
        function renderNotes() {
            document.getElementById('note-list').innerHTML = getNotes().map(n => `
                <li style="background:rgba(255,255,255,0.05); padding:10px; margin-bottom:5px; border-left:3px solid var(--neon-blue); display:flex; justify-content:space-between;">
                    <span>${n.text} <br><small style="color:#666">${n.date}</small></span>
                    <button onclick="deleteNote(${n.id})" style="color:var(--neon-pink); background:none; border:none; cursor:pointer;"><i class="fas fa-trash"></i></button>
                </li>
            `).join('');
        }
    </script>
</body>
</html>
