            <div class="modal-header"><h2>// ŞOFÖR YÖNETİM</h2><span onclick="closeModal('driver-modal')">✕</span></div>
            
            <div style="background:rgba(255,255,255,0.03); padding:20px; border-radius:10px; border:1px solid rgba(255,255,255,0.1); margin-bottom:20px;">
                <h4 style="color:var(--neon-blue); font-family:'Orbitron'; margin-bottom:15px; letter-spacing:1px;">YENİ KAYIT EKLE</h4>
