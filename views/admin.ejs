<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <title>Ege Kalyon | Terminal V3.5 Cyber</title>
    <style>
        :root { 
            --neon-blue: #00f3ff;
            --neon-pink: #bc13fe;
            --neon-green: #0aff0a;
            --warning: #f59e0b; 
            --danger: #ff2a2a; 
            --bg-dark: #050505;
            --glass: rgba(0, 10, 20, 0.6);
            --border: rgba(0, 243, 255, 0.2);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background-color: var(--bg-dark);
            color: #fff;
            font-family: 'Share Tech Mono', monospace; /* Teknoloji fontu */
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        /* UZAY VE GRID ARKA PLAN ANİMASYONU */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: 
                linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px),
                radial-gradient(circle at 50% 50%, rgba(20, 20, 50, 0.5), #000);
            background-size: 50px 50px, 50px 50px, 100% 100%;
            z-index: -2;
            animation: gridMove 20s linear infinite;
        }
        
        /* HAREKETLİ YILDIZLAR */
        body::after {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                radial-gradient(white, rgba(255,255,255,.2) 2px, transparent 3px),
                radial-gradient(white, rgba(255,255,255,.15) 1px, transparent 2px),
                radial-gradient(white, rgba(255,255,255,.1) 2px, transparent 3px);
            background-size: 550px 550px, 350px 350px, 250px 250px;
            background-position: 0 0, 40px 60px, 130px 270px;
            z-index: -1;
            animation: starMove 100s linear infinite;
        }

        @keyframes gridMove { 0% { background-position: 0 0, 0 0, 0 0; } 100% { background-position: 0 50px, 0 50px, 0 0; } }
        @keyframes starMove { from { transform: translateY(0); } to { transform: translateY(-1000px); } }

        /* CRT SCANLINE EFEKTİ */
        .scanlines {
            position: fixed; left: 0; top: 0; width: 100vw; height: 100vh;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2));
            background-size: 100% 4px;
            z-index: 9999;
            pointer-events: none;
            opacity: 0.6;
        }

        /* SIDEBAR */
        .sidebar { 
            width: 280px; height: 100vh; position: fixed; left: 0; top: 0; 
            background: rgba(5, 5, 10, 0.9); 
            border-right: 1px solid var(--neon-blue); 
            padding: 30px 20px; z-index: 100; 
            box-shadow: 5px 0 25px rgba(0, 243, 255, 0.1);
            backdrop-filter: blur(10px);
        }
        
        .sidebar-title {
            font-family: 'Orbitron', sans-serif;
            color: var(--neon-blue);
            text-shadow: 0 0 10px var(--neon-blue);
            letter-spacing: 2px;
            margin-bottom: 50px;
            border-bottom: 2px solid var(--neon-blue);
            padding-bottom: 10px;
        }

        .nav-item {
            display: flex; align-items: center; gap: 15px; 
            color: #ccc; text-decoration: none; padding: 15px; 
            margin-bottom: 15px; border-radius: 5px;
            border: 1px solid transparent;
            transition: 0.3s;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
        }

        .nav-item:hover, .nav-item.active {
            background: rgba(0, 243, 255, 0.1);
            border: 1px solid var(--neon-blue);
            color: var(--neon-blue);
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
            transform: translateX(10px);
        }

        /* CONTENT AREA */
        .admin-main { flex: 1; margin-left: 280px; min-height: 100vh; display: flex; flex-direction: column; width: calc(100% - 280px); position: relative; z-index: 1; }
        .content-wrapper { padding: 40px; flex: 1; }

        /* GLITCH HEADER */
        .glitch-wrapper { position: relative; }
        .glitch {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem; font-weight: 900;
            color: #fff;
            position: relative;
            text-transform: uppercase;
        }
        .glitch::before, .glitch::after {
            content: attr(data-text); position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        }
        .glitch::before { left: 2px; text-shadow: -1px 0 var(--neon-pink); clip: rect(44px, 450px, 56px, 0); animation: glitch-anim 5s infinite linear alternate-reverse; }
        .glitch::after { left: -2px; text-shadow: -1px 0 var(--neon-blue); clip: rect(44px, 450px, 56px, 0); animation: glitch-anim2 5s infinite linear alternate-reverse; }
        
        @keyframes glitch-anim { 0% { clip: rect(11px, 9999px, 81px, 0); } 100% { clip: rect(80px, 9999px, 5px, 0); } }
        @keyframes glitch-anim2 { 0% { clip: rect(65px, 9999px, 10px, 0); } 100% { clip: rect(10px, 9999px, 85px, 0); } }

        /* DIGITAL CLOCK */
        #digital-clock { 
            font-family: 'Orbitron', sans-serif; 
            font-size: 2.5rem; color: var(--neon-blue); 
            text-shadow: 0 0 20px var(--neon-blue); 
        }
        #digital-date { color: var(--neon-pink); letter-spacing: 3px; font-weight: bold; text-align: right; }

        /* CYBER CARDS */
        .grid-cockpit-v2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 25px; margin-top: 30px; }
        
        .cyber-card { 
            background: rgba(10, 15, 30, 0.7); 
            border: 1px solid var(--border); 
            position: relative; 
            padding: 30px; 
            transition: 0.4s; 
            cursor: pointer;
            overflow: hidden;
            clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
            backdrop-filter: blur(5px);
        }

        .cyber-card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-blue), transparent);
            transform: translateX(-100%); transition: 0.5s;
        }

        .cyber-card:hover { 
            background: rgba(0, 243, 255, 0.05); 
            border-color: var(--neon-blue); 
            box-shadow: 0 0 30px rgba(0, 243, 255, 0.2); 
            transform: translateY(-5px);
        }
        .cyber-card:hover::before { transform: translateX(100%); transition: 1s; }

        .cyber-card i { font-size: 2.5rem; margin-bottom: 15px; filter: drop-shadow(0 0 10px rgba(255,255,255,0.5)); }
        .card-info h3 { font-family: 'Orbitron', sans-serif; margin-bottom: 5px; color: #fff; }
        .card-info p { color: #aaa; font-size: 0.8rem; letter-spacing: 1px; }

        /* MODAL STYLES */
        .modal { display: none; position: fixed; z-index: 3000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); }
        .modal-content { 
            background: #050505; margin: 5% auto; padding: 40px; 
            border: 1px solid var(--neon-blue); 
            width: 90%; max-width: 900px; 
            box-shadow: 0 0 50px rgba(0, 243, 255, 0.2); 
            position: relative;
        }
        /* Köşe Süsleri */
        .modal-content::after {
            content: ""; position: absolute; bottom: -1px; right: -1px; width: 30px; height: 30px;
            border-bottom: 3px solid var(--neon-blue); border-right: 3px solid var(--neon-blue);
        }
        .modal-content::before {
            content: ""; position: absolute; top: -1px; left: -1px; width: 30px; height: 30px;
            border-top: 3px solid var(--neon-blue); border-left: 3px solid var(--neon-blue);
        }

        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid #333; padding-bottom: 15px; }
        .modal-header h2 { font-family: 'Orbitron'; color: var(--neon-blue); }
        .modal-header span { color: var(--danger); font-size: 1.5rem; transition: 0.3s; }
        .modal-header span:hover { text-shadow: 0 0 10px var(--danger); }

        /* INPUTS */
        .cyber-input {
            background: rgba(255,255,255,0.05); 
            border: 1px solid #333; 
            color: var(--neon-blue); 
            padding: 15px; 
            width: 100%; 
            outline: none;
            font-family: 'Share Tech Mono', monospace;
            transition: 0.3s;
        }
        .cyber-input:focus { border-color: var(--neon-blue); box-shadow: 0 0 15px rgba(0, 243, 255, 0.2); background: rgba(0,0,0,0.8); }

        /* BUTTONS */
        .cyber-btn {
            background: transparent;
            border: 1px solid var(--neon-blue);
            color: var(--neon-blue);
            padding: 12px 30px;
            font-family: 'Orbitron';
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .cyber-btn:hover {
            background: var(--neon-blue);
            color: #000;
            box-shadow: 0 0 20px var(--neon-blue);
        }

        /* TABLES */
        .driver-table { width:100%; border-collapse:collapse; margin-top: 20px; }
        .driver-table th { text-align: left; padding: 15px; color: var(--neon-pink); border-bottom: 1px solid var(--neon-blue); font-family: 'Orbitron'; letter-spacing: 1px; }
        .driver-table td { padding: 15px; border-bottom: 1px solid #222; color: #ccc; }
        .driver-table tr:hover { background: rgba(0, 243, 255, 0.05); }
        .expired-warning { color: var(--danger) !important; font-weight: bold; text-shadow: 0 0 10px red; animation: blink 1s infinite; }
        @keyframes blink { 50% { opacity: 0.5; } }

        /* FOOTER */
        .admin-footer { padding: 30px; border-top: 1px solid #222; text-align: center; color: #555; font-size: 0.8rem; }

        @media (max-width: 1024px) {
            .sidebar { width: 80px; padding: 20px 10px; }
            .sidebar-title, .sidebar-nav a span { display: none; }
            .admin-main { margin-left: 80px; width: calc(100% - 80px); }
        }
    </style>
</head>
<body>
    <div class="scanlines"></div> <aside class="sidebar">
        <div class="sidebar-title">EGE KALYON <span style="font-size:0.7em; color:var(--neon-pink)">OS v3.5</span></div>
        <nav class="sidebar-nav">
            <a href="/admin" class="nav-item active"><i class="fas fa-terminal"></i> <span>Dashboard</span></a>
            <a href="#" onclick="openSheets('cizelge')" class="nav-item"><i class="fas fa-table"></i> <span>Çizelge</span></a>
            <a href="#" onclick="openSheets('bekleme')" class="nav-item"><i class="fas fa-clock"></i> <span>Bekleme</span></a>
            <a href="#" onclick="openModal('driver-modal')" class="nav-item"><i class="fas fa-users-gear"></i> <span>Şoförler</span></a>
            <a href="#" onclick="openModal('note-modal')" class="nav-item"><i class="fas fa-sticky-note"></i> <span>Notlar</span></a>
            <a href="/cikis" class="nav-item" style="color: var(--danger); border-color:var(--danger)"><i class="fas fa-power-off"></i> <span>Bağlantıyı Kes</span></a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="content-wrapper">
            <header class="admin-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
                <div data-aos="fade-right">
                    <div class="glitch-wrapper">
                        <h1 class="glitch" data-text="TERMINAL OTORITESI">TERMINAL OTORITESI</h1>
                    </div>
                    <p style="color: var(--neon-green); margin-top: 10px; font-size: 1.1rem;">>> SISTEM ONLINE. HOSGELDIN, EGE KALYON.</p>
                </div>
                <div style="text-align: right;" data-aos="fade-left">
                    <div id="digital-clock">00:00:00</div>
                    <div id="digital-date">...</div>
                </div>
            </header>

            <section class="grid-cockpit-v2">
                <div class="cyber-card" onclick="openSheets('cizelge')" data-aos="zoom-in" data-aos-delay="100">
                    <i class="fas fa-file-excel" style="color: #4285F4;"></i>
                    <div class="card-info"><h3>DİJİTAL ÇİZELGE</h3><p>DATA ANALİZİ</p></div>
                </div>

                <div class="cyber-card" onclick="openSheets('bekleme')" data-aos="zoom-in" data-aos-delay="200">
                    <i class="fas fa-stopwatch" style="color: var(--warning);"></i>
                    <div class="card-info"><h3>BEKLEME MODÜLÜ</h3><p>HAKEDİŞ HESABI</p></div>
                </div>

                <a href="https://web.arvento.com/" target="_blank" class="cyber-card" style="text-decoration:none;" data-aos="zoom-in" data-aos-delay="300">
                    <i class="fas fa-satellite-dish" style="color: var(--danger);"></i>
                    <div class="card-info"><h3>ARVENTO SAT</h3><p>GPS UYDU AĞI</p></div>
                </a>

                <a href="https://www.luca.com.tr/" target="_blank" class="cyber-card" style="text-decoration:none;" data-aos="zoom-in" data-aos-delay="400">
                    <i class="fas fa-calculator" style="color: var(--neon-pink);"></i>
                    <div class="card-info"><h3>LUCA FİNANS</h3><p>MUHASEBE AĞI</p></div>
                </a>

                <div class="cyber-card" onclick="openModal('driver-modal')" style="border-color: var(--neon-green);" data-aos="zoom-in" data-aos-delay="500">
                    <i class="fas fa-user-astronaut" style="color: var(--neon-green);"></i>
                    <div class="card-info"><h3>PERSONEL</h3><p>ŞOFÖR VERİTABANI</p></div>
                </div>

                <div class="cyber-card" onclick="openModal('sunucu-modal')" data-aos="zoom-in" data-aos-delay="600">
                    <i class="fas fa-server" style="color: var(--neon-blue);"></i>
                    <div class="card-info"><h3>ANA SUNUCU</h3><p>SİSTEM DURUMU</p></div>
                </div>
            </section>
        </div>

        <footer class="admin-footer">
            <div>EGE KALYON LOJİSTİK SİSTEMLERİ V3.5</div>
            <div style="margin-top:5px; opacity:0.5;">CODE BY BATU YAZILIM</div>
        </footer>
    </main>

    <div id="note-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// OPERASYONEL NOTLAR</h2><span onclick="closeModal('note-modal')" style="cursor:pointer">✕</span></div>
            <div style="display:flex; gap:10px; margin-bottom:20px;">
                <input type="text" id="note-input" placeholder="Veri girişi yapın..." class="cyber-input">
                <button id="note-save-btn" onclick="addNote()" class="cyber-btn">KAYDET</button>
            </div>
            <ul id="note-list" style="list-style:none;"></ul>
        </div>
    </div>

    <div id="driver-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h2>// ŞOFÖR YÖNETİM PANELİ</h2><span onclick="closeModal('driver-modal')" style="cursor:pointer">✕</span></div>
            
            <div style="background:rgba(0,0,0,0.5); padding:20px; border:1px dashed var(--neon-blue); margin-bottom:20px;">
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 15px;">
                    <input type="text" id="d-name" placeholder="Ad Soyad" class="cyber-input">
                    <input type="text" id="d-tc" placeholder="TC Kimlik No" class="cyber-input" maxlength="11">
                    <input type="text" id="d-phone" placeholder="Telefon (5XX...)" class="cyber-input">
                    <input type="text" id="d-plate" placeholder="Plaka" class="cyber-input">
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.75rem; color: var(--neon-blue); margin-bottom: 5px;">Ehliyet SKT</span>
                        <input type="date" id="d-lic-date" class="cyber-input" style="color-scheme: dark;">
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 0.75rem; color: var(--neon-blue); margin-bottom: 5px;">SRC SKT</span>
                        <input type="date" id="d-src-date" class="cyber-input" style="color-scheme: dark;">
                    </div>
                </div>
                <button onclick="addDriver()" class="cyber-btn" style="width:100%">PERSONELİ SİSTEME İŞLE</button>
            </div>

            <div style="overflow-x: auto;">
                <table class="driver-table">
                    <thead>
                        <tr>
                            <th>KİMLİK</th>
                            <th>İLETİŞİM / TC</th>
                            <th>ARAÇ ID</th>
                            <th>EHLİYET DURUM</th>
                            <th>SRC DURUM</th>
                            <th style="text-align: right;">KOMUT</th>
                        </tr>
                    </thead>
                    <tbody id="driver-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="sheets-overlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:#000; z-index:4000; display:none; flex-direction:column;">
        <div style="background:#111; padding:15px; display:flex; justify-content:space-between; border-bottom:1px solid var(--neon-blue);">
            <h2 style="color:var(--neon-blue); font-family:'Orbitron'">VERİ BAĞLANTISI</h2>
            <button onclick="closeSheets()" class="cyber-btn" style="border-color:red; color:red;">BAĞLANTIYI KES</button>
        </div>
        <iframe id="sheets-iframe" src="" style="width:100%; height:100%; border:none;"></iframe>
    </div>

    <div id="sunucu-modal" class="modal">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header"><h2>SUNUCU DURUMU</h2><span onclick="closeModal('sunucu-modal')" style="cursor:pointer">✕</span></div>
            <div style="font-size:1.2rem; color:var(--neon-green); margin-bottom:10px;">SYSTEM: OPTIMAL</div>
            <div style="font-size:1.2rem; color:var(--neon-blue);">DATA FLOW: STABLE</div>
            <div style="margin-top:20px; font-size:3rem;"><i class="fas fa-microchip fa-spin"></i></div>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init();
        
        // Dijital Saat
        setInterval(() => {
            const now = new Date();
            document.getElementById('digital-clock').innerText = now.toLocaleTimeString('tr-TR');
            document.getElementById('digital-date').innerText = now.toLocaleDateString('tr-TR', { day:'numeric', month:'long', year:'numeric' }).toUpperCase();
        }, 1000);

        // Modal İşlemleri
        function openModal(id) { document.getElementById(id).style.display = 'block'; if(id==='driver-modal') renderDrivers(); if(id==='note-modal') renderNotes(); }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        // Google Sheets
        function openSheets(type) {
            const overlay = document.getElementById('sheets-overlay');
            const iframe = document.getElementById('sheets-iframe');
            if(type==='cizelge') iframe.src = "https://docs.google.com/spreadsheets/d/1WaSNv0a2Nn-xDiHMX3VsLwYaOwTS5maCtrzRS9zUdlc/edit?rm=minimal";
            else iframe.src = "https://docs.google.com/spreadsheets/d/1sCy68YJYkvFIpQumgP6_tt5mcBFgDm2WLIbvuVHCgIM/edit?rm=minimal";
            overlay.style.display = 'flex';
        }
        function closeSheets() { document.getElementById('sheets-overlay').style.display = 'none'; document.getElementById('sheets-iframe').src = ""; }

        /* NOT SİSTEMİ (Mantık Aynen Korundu) */
        let editNoteId = null;
        function getNotes() { return JSON.parse(localStorage.getItem('terminal_notes_v3') || '[]'); }
        function saveNotes(notes) { localStorage.setItem('terminal_notes_v3', JSON.stringify(notes)); }
        function addNote() {
            const input = document.getElementById('note-input');
            if(!input.value) return;
            const notes = getNotes();
            const now = new Date();
            const dateStr = now.toLocaleDateString('tr-TR') + " " + now.toLocaleTimeString('tr-TR', {hour: '2-digit', minute:'2-digit'});
            if(editNoteId) {
                const updatedNotes = notes.map(n => n.id === editNoteId ? {...n, text: input.value, date: dateStr} : n);
                saveNotes(updatedNotes); editNoteId = null;
                document.getElementById('note-save-btn').innerText = "KAYDET";
            } else {
                notes.push({ id: Date.now(), text: input.value, date: dateStr, done: false });
                saveNotes(notes);
            }
            input.value = ""; renderNotes();
        }
        function startEdit(id, text) {
            document.getElementById('note-input').value = text;
            editNoteId = id; document.getElementById('note-save-btn').innerText = "GÜNCELLE";
            document.getElementById('note-input').focus();
        }
        function deleteNote(id) { saveNotes(getNotes().filter(n => n.id !== id)); renderNotes(); }
        function toggleNote(id) { saveNotes(getNotes().map(n => n.id === id ? {...n, done: !n.done} : n)); renderNotes(); }
        
        function renderNotes() {
            document.getElementById('note-list').innerHTML = getNotes().map(n => `
                <li style="background:rgba(255,255,255,0.05); padding:10px; margin-bottom:5px; border-left:3px solid ${n.done ? 'var(--neon-green)' : 'var(--neon-pink)'}; display:flex; justify-content:space-between;">
                    <span style="${n.done ? 'text-decoration:line-through; opacity:0.5' : ''}; font-family:'Share Tech Mono'">${n.text} <small style="display:block; color:#666; font-size:0.7em;">${n.date}</small></span>
                    <div>
                        <button onclick="toggleNote(${n.id})" style="background:none; border:none; color:var(--neon-green); cursor:pointer;"><i class="fas fa-check"></i></button>
                        <button onclick="startEdit(${n.id}, '${n.text.replace(/'/g, "\\'")}')" style="background:none; border:none; color:var(--neon-blue); cursor:pointer;"><i class="fas fa-edit"></i></button>
                        <button onclick="deleteNote(${n.id})" style="background:none; border:none; color:var(--danger); cursor:pointer;"><i class="fas fa-trash"></i></button>
                    </div>
                </li>`).join('');
        }

        /* ŞOFÖR SİSTEMİ (Mantık Aynen Korundu) */
        function getDrivers() { return JSON.parse(localStorage.getItem('drivers_v4') || '[]'); }
        function addDriver() {
            const name = document.getElementById('d-name').value;
            const tc = document.getElementById('d-tc').value;
            const phone = document.getElementById('d-phone').value;
            const plate = document.getElementById('d-plate').value;
            const licDate = document.getElementById('d-lic-date').value;
            const srcDate = document.getElementById('d-src-date').value;
            if(!name) { alert("ERROR: İSİM GİRİŞİ ZORUNLU."); return; }
            const drivers = getDrivers();
            drivers.push({ id: Date.now(), name, tc, phone, plate, licDate, srcDate });
            localStorage.setItem('drivers_v4', JSON.stringify(drivers));
            document.getElementById('d-name').value = ""; document.getElementById('d-tc').value = "";
            document.getElementById('d-phone').value = ""; document.getElementById('d-plate').value = "";
            document.getElementById('d-lic-date').value = ""; document.getElementById('d-src-date').value = "";
            renderDrivers();
        }
        function deleteDriver(id) {
            if(confirm('PERSONEL KAYDI SİLİNECEK. ONAYLIYOR MUSUNUZ?')) {
                localStorage.setItem('drivers_v4', JSON.stringify(getDrivers().filter(d => d.id !== id)));
                renderDrivers();
            }
        }
        function isExpired(dateString) {
            if (!dateString) return false;
            const today = new Date(); today.setHours(0,0,0,0);
            return new Date(dateString) < today;
        }
        function formatDate(dateString) {
            if (!dateString) return "-";
            return new Date(dateString).toLocaleDateString('tr-TR');
        }
        function renderDrivers() {
            const tbody = document.getElementById('driver-tbody');
            const drivers = getDrivers();
            if (drivers.length === 0) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px; color:#555;">// VERİTABANI BOŞ //</td></tr>'; return; }
            tbody.innerHTML = drivers.map(d => {
                const licExpired = isExpired(d.licDate);
                const srcExpired = isExpired(d.srcDate);
                let licHtml = `<span>${formatDate(d.licDate)}</span>`;
                if(licExpired) licHtml = `<span class="expired-warning">⚠ SÜRE DOLDU (${formatDate(d.licDate)})</span>`;
                let srcHtml = `<span>${formatDate(d.srcDate)}</span>`;
                if(srcExpired) srcHtml = `<span class="expired-warning">⚠ SÜRE DOLDU (${formatDate(d.srcDate)})</span>`;
                return `
                <tr style="border-left: 2px solid ${(licExpired || srcExpired) ? 'var(--danger)' : 'var(--neon-green)'}">
                    <td><b style="color:#fff">${d.name}</b></td>
                    <td><div style="font-size:0.8rem; color:#888;">TC: ${d.tc || '-'}</div><div style="font-size:0.8rem; color:var(--neon-blue);">${d.phone || '-'}</div></td>
                    <td><span style="border:1px solid #555; padding:2px 5px; color:var(--warning)">${d.plate || '-'}</span></td>
                    <td>${licHtml}</td>
                    <td>${srcHtml}</td>
                    <td style="text-align:right"><button onclick="deleteDriver(${d.id})" style="color:var(--danger); background:none; border:none; cursor:pointer;"><i class="fas fa-trash"></i></button></td>
                </tr>`;
            }).join('');
        }
    </script>
</body>
</html>
