
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@300;500;600;700&display=swap" rel="stylesheet">
    <title>Ege Kalyon | TITAN V1.8</title>
    <style>
        :root { 
            --neon-blue: #00f3ff;
            --neon-purple: #bc13fe;
            --neon-pink: #ff0055;
            --neon-yellow: #fcee0a;
            --neon-green: #0aff0a;
            --neon-orange: #ff9d00;
            --bg-dark: #020204;
            --glass-bg: rgba(15, 20, 30, 0.85);
            --glass-border: rgba(0, 243, 255, 0.2);
            --text-main: #e0e0e0;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Rajdhani', sans-serif;
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
            font-size: 16px;
        }

        /* --- LOADER (AÇILIŞ) --- */
        #boot-screen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #000; z-index: 9999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            transition: opacity 0.8s ease-out;
        }
        .loader-wrapper { position: relative; width: 300px; text-align: center; }
        .loader-logo { font-family: 'Orbitron'; font-size: 2rem; color: #fff; text-shadow: 0 0 20px var(--neon-blue); margin-bottom: 20px; animation: glitchText 2s infinite; }
        .progress-container { width: 100%; height: 6px; background: #222; border-radius: 3px; overflow: hidden; border: 1px solid #444; }
        .progress-bar { width: 0%; height: 100%; background: var(--neon-blue); box-shadow: 0 0 15px var(--neon-blue); animation: loadBar 2.5s cubic-bezier(0.2, 0, 0.4, 1) forwards; }
        .boot-cmd { font-family: 'Courier New'; color: var(--neon-green); font-size: 0.75rem; margin-top: 10px; text-align: left; height: 80px; overflow: hidden; opacity: 0.8; }
        
        @keyframes loadBar { 0% { width: 0%; } 50% { width: 40%; } 100% { width: 100%; } }

        /* --- ARKA PLAN EFEKTLERİ --- */
        .cyber-grid {
            position: fixed; width: 200%; height: 200%; top: -50%; left: -50%;
            background-image: 
                linear-gradient(rgba(0, 243, 255, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(188, 19, 254, 0.1) 1px, transparent 1px);
            background-size: 80px 80px;
            transform: perspective(500px) rotateX(60deg);
            animation: gridFlow 20s linear infinite;
            z-index: -2; pointer-events: none;
        }
        @keyframes gridFlow { 0% { transform: perspective(500px) rotateX(60deg) translateY(0); } 100% { transform: perspective(500px) rotateX(60deg) translateY(80px); } }

        .scanlines {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%);
            background-size: 100% 4px; z-index: 9000; pointer-events: none; opacity: 0.3;
        }

        /* --- SIDEBAR --- */
        .sidebar { 
            width: 280px; height: 100vh; position: fixed; left: 0; top: 0; 
            background: rgba(8, 10, 15, 0.9); backdrop-filter: blur(15px);
            border-right: 1px solid var(--glass-border); 
            padding: 30px 15px; z-index: 1000; display: flex; flex-direction: column;
            box-shadow: 10px 0 30px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
        }
        
        .brand {
            text-align: center; margin-bottom: 40px; border-bottom: 2px solid var(--neon-blue); padding-bottom: 20px;
        }
        .brand h1 { font-family: 'Orbitron'; color: #fff; font-size: 1.5rem; text-shadow: 0 0 10px var(--neon-blue); margin: 0; }
        .brand span { color: var(--neon-green); font-size: 0.7rem; letter-spacing: 4px; font-weight: bold; }

        .nav-menu { flex: 1; overflow-y: auto; }
        .nav-item {
            display: flex; align-items: center; gap: 15px; 
            color: #aaa; text-decoration: none; padding: 12px 15px; margin-bottom: 5px;
            font-family: 'Orbitron'; font-size: 0.85rem; border-radius: 5px;
            border: 1px solid transparent; transition: all 0.3s;
        }
        .nav-item i { width: 20px; text-align: center; transition: 0.3s; }
        .nav-item:hover, .nav-item.active {
            background: rgba(0, 243, 255, 0.1); color: #fff; border-color: var(--neon-blue);
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.2); transform: translateX(5px);
        }
        .nav-item:hover i { color: var(--neon-blue); text-shadow: 0 0 5px var(--neon-blue); }

        /* --- MAIN AREA --- */
        .main-content { flex: 1; margin-left: 280px; padding: 30px; position: relative; z-index: 1; transition: 0.3s; }

        /* HEADER */
        .header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .page-title h2 { font-family: 'Orbitron'; font-size: 2rem; color: #fff; text-shadow: 2px 2px var(--neon-purple); }
        .system-badges { display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; }
        .badge { font-size: 0.7rem; padding: 4px 8px; border: 1px solid; border-radius: 4px; font-weight: bold; display: flex; align-items: center; gap: 5px; }
        
        .clock-box { text-align: right; font-family: 'Orbitron'; color: #fff; }
        .clock-time { font-size: 2.5rem; font-weight: bold; text-shadow: 0 0 15px rgba(255,255,255,0.3); line-height: 1; }
        .clock-date { color: var(--neon-yellow); font-size: 0.9rem; letter-spacing: 2px; }

        /* --- DASHBOARD GRID SYSTEM --- */
        .dashboard-container { 
            display: grid; 
            grid-template-columns: 280px 1fr 300px; 
            gap: 25px; 
            align-items: start;
        }

        /* LEFT PANEL (STATS & ACTIONS) */
        .left-panel { display: flex; flex-direction: column; gap: 20px; }
        
        .panel-box {
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            padding: 20px; border-radius: 10px; position: relative; overflow: hidden;
        }
        .panel-header { font-family: 'Orbitron'; color: var(--neon-blue); margin-bottom: 15px; font-size: 0.9rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px; }
        
        .quick-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .action-btn {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
            color: #fff; padding: 15px 5px; text-align: center; cursor: pointer;
            border-radius: 5px; transition: 0.3s; font-size: 0.8rem;
        }
        .action-btn:hover { background: var(--neon-blue); color: #000; box-shadow: 0 0 15px var(--neon-blue); }
        .action-btn i { display: block; font-size: 1.5rem; margin-bottom: 5px; }

        .stat-list { list-style: none; padding: 0; }
        .stat-item { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.9rem; color: #ccc; }
        .stat-item b { color: #fff; font-family: 'Orbitron'; }

        /* CENTER (CARDS) */
        .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
        
        .cyber-card {
            background: var(--glass-bg); border: 1px solid rgba(255,255,255,0.1);
            padding: 20px; border-radius: 12px; position: relative;
            transition: 0.4s; cursor: pointer; overflow: hidden;
            display: flex; flex-direction: column; justify-content: space-between; min-height: 140px;
        }
        .cyber-card::before {
            content: ''; position: absolute; top:0; left:0; width: 4px; height: 100%; background: var(--neon-blue); opacity: 0.5; transition: 0.3s;
        }
        .cyber-card:hover { transform: translateY(-5px) scale(1.02); box-shadow: 0 10px 30px rgba(0,0,0,0.5); border-color: var(--neon-blue); }
        .cyber-card:hover::before { opacity: 1; box-shadow: 0 0 10px var(--neon-blue); }
        
        .card-icon { font-size: 2.5rem; color: #555; margin-bottom: 10px; transition: 0.3s; align-self: flex-start; }
        .cyber-card:hover .card-icon { color: #fff; filter: drop-shadow(0 0 10px var(--neon-blue)); transform: scale(1.1); }
        
        .card-title { font-family: 'Orbitron'; font-size: 1rem; color: #fff; margin-bottom: 5px; }
        .card-desc { font-size: 0.75rem; color: var(--neon-blue); font-weight: bold; }

        /* RIGHT PANEL (LOGS & WEATHER) */
        .right-panel { display: flex; flex-direction: column; gap: 20px; }
        
        .terminal-log {
            background: #000; border: 1px solid var(--neon-green); border-radius: 5px;
            height: 250px; padding: 15px; font-family: 'Courier New', monospace;
            font-size: 0.7rem; color: var(--neon-green); overflow-y: hidden; position: relative;
        }
        .terminal-log::after { content: 'SYSTEM_MONITOR_ACTIVATE'; position: absolute; bottom: 5px; right: 5px; opacity: 0.5; font-size: 0.6rem; }
        .log-entry { margin-bottom: 4px; border-bottom: 1px solid rgba(0, 255, 0, 0.1); padding-bottom: 2px; animation: fadeIn 0.3s; }

        /* MODALS */
        .modal { display: none; position: fixed; z-index: 5000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); backdrop-filter: blur(10px); }
        .modal-content { 
            background: #0a0c12; margin: 3% auto; padding: 30px; 
            border: 1px solid var(--neon-blue); border-top: 4px solid var(--neon-blue);
            width: 90%; max-width: 900px; max-height: 90vh; overflow-y: auto;
            box-shadow: 0 0 100px rgba(0, 243, 255, 0.15); animation: modalOpen 0.4s ease;
            position: relative;
        }
        .modal-close { position: absolute; top: 20px; right: 20px; color: var(--neon-pink); font-size: 1.5rem; cursor: pointer; transition: 0.3s; }
        .modal-close:hover { transform: rotate(90deg); text-shadow: 0 0 10px var(--neon-pink); }
        .modal-header h2 { font-family: 'Orbitron'; color: var(--neon-blue); border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 20px; }

        @keyframes modalOpen { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }

        /* FORM ELEMENTS */
        .cyber-input { 
            width: 100%; background: rgba(255,255,255,0.05); border: 1px solid #333; 
            color: #fff; padding: 12px; font-family: 'Rajdhani'; border-radius: 5px; outline: none; transition: 0.3s;
        }
        .cyber-input:focus { border-color: var(--neon-blue); background: rgba(0,0,0,0.5); box-shadow: 0 0 10px rgba(0,243,255,0.2); }
        
        .cyber-btn {
            background: linear-gradient(45deg, transparent 5%, var(--neon-blue) 5%);
            color: #000; border: none; padding: 12px 30px; font-family: 'Orbitron'; font-weight: bold;
            cursor: pointer; clip-path: polygon(0 0, 100% 0, 100% 80%, 95% 100%, 0 100%);
            transition: 0.3s; width: 100%; margin-top: 10px;
        }
        .cyber-btn:hover { background: #fff; box-shadow: 0 0 20px #fff; }

        /* TABLES */
        .data-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        .data-table th { text-align: left; padding: 12px; color: var(--neon-purple); border-bottom: 1px solid #444; font-family: 'Orbitron'; font-size: 0.8rem; }
        .data-table td { padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); color: #ccc; }
        .data-table tr:hover td { background: rgba(255,255,255,0.05); color: #fff; }

        /* IFRAME OVERLAY */
        #sheets-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 6000; flex-direction: column; }
        .overlay-bar { background: #111; padding: 15px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--neon-blue); }

        /* RESPONSIVE */
        .menu-toggle { display: none; position: fixed; top: 20px; left: 20px; z-index: 2000; background: #000; border: 1px solid var(--neon-blue); color: var(--neon-blue); padding: 10px; border-radius: 5px; }
        
        @media (max-width: 1200px) { .dashboard-container { grid-template-columns: 1fr; } .left-panel, .right-panel { display: none; } }
        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            .sidebar { transform: translateX(-100%); width: 280px; }
            .sidebar.active { transform: translateX(0); }
            .main-content { margin-left: 0; width: 100%; padding: 15px; padding-top: 70px; }
            .header { flex-direction: column; align-items: flex-start; gap: 15px; }
            .clock-box { text-align: left; }
            .modal-content { width: 95%; margin: 10% auto; }
        }
    </style>
</head>
<body>

    <div id="boot-screen">
        <div class="loader-wrapper">
            <div class="loader-logo">EGE KALYON OS</div>
            <div class="progress-container"><div class="progress-bar"></div></div>
            <div class="boot-cmd" id="boot-cmd"></div>
        </div>
    </div>

    <div class="cyber-grid"></div>
    <div class="scanlines"></div>

    <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>

    <aside class="sidebar" id="mySidebar">
        <div class="brand">
            <h1>TITAN V1.8</h1>
            <span>LOJİSTİK YÖNETİMİ</span>
        </div>
        
        <div class="nav-menu">
            <a href="/admin" class="nav-item active"><i class="fas fa-rocket"></i> KOKPİT</a>
            <a href="#" onclick="openSheets('cizelge')" class="nav-item"><i class="fas fa-file-waveform"></i> CANLI ÇİZELGE</a>
            <a href="#" onclick="openSheets('bekleme')" class="nav-item"><i class="fas fa-hourglass-half"></i> BEKLEME ANALİZİ</a>
            <a href="#" onclick="openModal('driver-modal')" class="nav-item"><i class="fas fa-users-viewfinder"></i> PERSONEL AĞI</a>
            <a href="#" onclick="openModal('fuel-modal')" class="nav-item"><i class="fas fa-gas-pump"></i> YAKIT & FİYAT</a>
            <a href="#" onclick="openModal('maintenance-modal')" class="nav-item"><i class="fas fa-wrench"></i> BAKIM & ONARIM</a>
            <a href="#" onclick="openModal('map-modal')" class="nav-item"><i class="fas fa-map-location-dot"></i> FİLO HARİTASI</a>
            <a href="#" onclick="openModal('finance-modal')" class="nav-item"><i class="fas fa-chart-line"></i> FİNANSAL RAPOR</a>
            <a href="#" onclick="openModal('note-modal')" class="nav-item"><i class="fas fa-microchip"></i> HAFIZA BANKASI</a>
