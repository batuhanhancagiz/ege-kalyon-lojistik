                    <div class="panel-header">// HIZLI ERİŞİM</div>
                    <div class="quick-actions">
                        <div class="action-btn" onclick="openModal('driver-modal')"><i class="fas fa-user-plus"></i>EKLE</div>
                        <div class="action-btn" onclick="openModal('note-modal')"><i class="fas fa-edit"></i>NOT</div>
                        <div class="action-btn" onclick="openModal('fuel-modal')"><i class="fas fa-calculator"></i>HESAPLA</div>
