        </a>
    </aside>

    <main class="main-content">
        
        <header class="header">
            <div class="page-title" data-aos="fade-right">
                <h2>KOMUTA MERKEZİ</h2>
                <div class="system-badges">
                    <span class="badge" style="color:var(--neon-green); border-color:var(--neon-green)"><i class="fas fa-wifi"></i> ONLINE</span>
                    <span class="badge" style="color:var(--neon-blue); border-color:var(--neon-blue)"><i class="fas fa-shield-alt"></i> SECURE</span>
                    <span class="badge" id="weather-badge" style="color:var(--neon-yellow); border-color:var(--neon-yellow)"><i class="fas fa-sun"></i> İZMİR: YÜKLENİYOR...</span>
                </div>
            </div>
