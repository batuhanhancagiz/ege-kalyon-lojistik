                    </ul>
                    <div style="width:100%; height:4px; background:#333; margin-top:10px; border-radius:2px;">
                        <div style="width:65%; height:100%; background:var(--neon-green); box-shadow:0 0 10px var(--neon-green)"></div>
                    </div>
                    <div style="text-align:right; font-size:0.7rem; color:#888; margin-top:5px;">VERİMLİLİK: %85</div>
